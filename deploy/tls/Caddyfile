{
	admin off
	auto_https off
	persist_config off
	grace_period 15s
	servers {
		protocols h1 h2
		strict_sni_host on
		max_header_size 32KB
		timeouts {
			read_header 5s
			read_body 15s
			write 60s
			idle 30s
		}
	}
}

(identity_backend) {
	reverse_proxy https://keycloak:8443 {
		header_up Host {hostport}
		header_up -Forwarded
		header_up -X-Real-IP
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {hostport}
		header_up X-Forwarded-Port {args[0]}
		transport http {
			tls_server_name {$CHIPLOAD_IDENTITY_HOST}
			tls_trust_pool file /etc/chipload/identity-ca.pem
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}

https://{$CHIPLOAD_API_HOST}:8443 {
	tls /tls/api.crt /tls/api.key
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 3145728
	}
	reverse_proxy api:8088 {
		header_up -Forwarded
		header_up -X-Real-IP
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {hostport}
		flush_interval -1
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
			max_conns_per_host 64
		}
	}
}

https://{$CHIPLOAD_IDENTITY_HOST}:8443 {
	tls /tls/identity.crt /tls/identity.key
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 1048576
	}
	@public path /realms/chipload/* /resources/* /.well-known/*
	handle @public {
		import identity_backend {$CHIPLOAD_TLS_PORT}
	}
	handle {
		respond 404
	}
}

# A separate listener, published only on host loopback, exposes administration.
https://{$CHIPLOAD_IDENTITY_HOST}:8444 {
	tls /tls/identity.crt /tls/identity.key
	request_body {
		max_size 1048576
	}
	import identity_backend {$CHIPLOAD_ADMIN_PORT}
}
