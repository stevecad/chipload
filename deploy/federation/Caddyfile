{
 admin off
 auto_https off
 persist_config off
 grace_period 5s
 servers {
  protocols h1 h2
  strict_sni_host on
  max_header_size 32KB
  timeouts {
   read_header 5s
   read_body 15s
   write 60s
   idle 30s
  }
 }
}
https://{$CHIPLOAD_CLOUD_HOST}:8443 {
 tls /tls/api.crt /tls/api.key
 header Strict-Transport-Security "max-age=31536000"
 request_body {
  max_size 3145728
 }
 reverse_proxy cloud:8090 {
  header_up -Forwarded
  header_up -X-Real-IP
  header_up X-Forwarded-For {remote_host}
  header_up X-Forwarded-Proto https
  header_up X-Forwarded-Host {hostport}
  flush_interval -1
  transport http {
   dial_timeout 3s
   response_header_timeout 35s
   max_conns_per_host 160
  }
 }
}
