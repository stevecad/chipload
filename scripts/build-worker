#!/usr/bin/env python3
"""Build the trusted SDK environment from a minimal, credential-free context."""

import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import tempfile


def main():
    root = Path(__file__).resolve().parents[1]
    source = root / "src/chipload"
    snapshot = {p.name: p.read_bytes() for p in sorted(source.glob("*.py"))}
    sdk_hash = hashlib.sha256(
        b"".join(name.encode() + b"\0" + content + b"\0" for name, content in snapshot.items())
    ).hexdigest()
    lock = (root / "uv.lock").read_bytes()
    dependencies_hash = hashlib.sha256(lock).hexdigest()
    with tempfile.TemporaryDirectory(prefix="chipload-worker-image-") as directory:
        context = Path(directory)
        (context / "chipload").mkdir()
        for name, content in snapshot.items():
            (context / "chipload" / name).write_bytes(content)
        (context / "uv.lock").write_bytes(lock)
        shutil.copyfile(root / "pyproject.toml", context / "pyproject.toml")
        shutil.copyfile(root / "deploy/worker/Dockerfile", context / "Dockerfile")
        subprocess.run(
            ["uv", "export", "--locked", "--no-dev", "--no-emit-project",
             "--format", "requirements-txt", "--output-file", str(context / "requirements.txt")],
            cwd=context, stdout=subprocess.DEVNULL, check=True,
        )
        print("Building the locked Chipload worker image.", flush=True)
        subprocess.run(
            ["docker", "build", "--build-arg", f"SDK_SHA256={sdk_hash}",
             "--build-arg", f"DEPENDENCIES_SHA256={dependencies_hash}",
             "--iidfile", str(context / "image-id"), str(context)],
            check=True,
        )
        image = (context / "image-id").read_text().strip()
        local = root / ".local"
        local.mkdir(mode=0o700, exist_ok=True)
        fd, temporary = tempfile.mkstemp(prefix="worker-image-", dir=local)
        try:
            with os.fdopen(fd, "w") as output:
                output.write(image + "\n")
            os.replace(temporary, local / "worker-image")
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        print(f"Worker image: {image}\nSaved .local/worker-image; no mutable tag is used.")


if __name__ == "__main__":
    main()
