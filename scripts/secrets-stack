#!/usr/bin/env python3
"""Manage a private TLS OpenBao container and PGP-encrypted threshold bootstrap."""

import argparse
import base64
import hashlib
import http.client
import importlib.machinery
import importlib.util
import json
import os
import re
import socket
import ssl
import subprocess
import tempfile
import time
from pathlib import Path

import recovery_archive as archive
import secrets_environment as image_environment

ROOT = Path(__file__).resolve().parents[1]


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(ROOT / path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    loader.exec_module(module)
    return module


executor = load("secrets_executor_helpers", "scripts/executor")
tls = load("secrets_tls_helpers", "scripts/tls-stack")
IMAGE, IMAGE_SHA256 = image_environment.specification(ROOT)
PENDING = ".initialize-incomplete.json"
BACKUP_PENDING = ".backup-incomplete.json"
WORKLOAD_PENDING = ".workload-incomplete.json"


class SecretsError(ValueError):
    """Operator-safe diagnostic without returned tokens, keys or response data."""


def configuration(value):
    if len(json.dumps(value).encode()) > 512 * 1024:
        raise SecretsError("secrets deployment configuration exceeds its size limit")
    if value.get("version") != 1 or value.get("image") != IMAGE:
        raise SecretsError("unsupported secrets deployment version or image")
    for name in ("name", "network"):
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,62}", value[name]):
            raise SecretsError("use lowercase project and network names")
    host = value["host"]
    if not re.fullmatch(r"[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?", host) or any(
        not label or len(label) > 63 or label.startswith("-") or label.endswith("-")
        for label in host.split(".")
    ):
        raise SecretsError("use a DNS hostname without a port")
    if (
        type(value["threshold"]) is not int
        or not 2 <= value["threshold"] <= len(value["pgp_keys"]) <= 10
        or len(set(value["fingerprints"])) != len(value["pgp_keys"])
    ):
        raise SecretsError("use 2–10 distinct share recipients and a threshold of at least two")
    return value


def read_json(path):
    archive.private(path)
    if path.stat().st_size > 1024 * 1024:
        raise SecretsError("operator state exceeds its size limit")
    return json.loads(path.read_bytes())


def pgp_public(path):
    data = path.read_bytes()
    if len(data) > 128 * 1024:
        raise SecretsError("PGP public key exceeds its size limit")
    with tempfile.TemporaryDirectory(prefix="chipload-pgp-") as temporary:
        command = [
            "gpg",
            "--homedir",
            temporary,
            "--no-options",
            "--batch",
            "--no-auto-key-retrieve",
        ]
        result = subprocess.run(
            [*command, "--with-colons", "--import-options", "show-only", "--dry-run", "--import"],
            input=data,
            capture_output=True,
            timeout=15,
        )
        records = [line.split(":") for line in result.stdout.decode().splitlines()]
        pubs = [row for row in records if row[0] == "pub"]
        if (
            result.returncode
            or len(pubs) != 1
            or any(row[0] in {"sec", "ssb"} for row in records)
            or pubs[0][1] in {"r", "e", "d"}
            or "e" not in pubs[0][11].lower()
            or (pubs[0][6] and int(pubs[0][6]) <= time.time())
        ):
            raise SecretsError("provide one valid encryption-capable public PGP key per recipient")
        fingerprint = next(row[9] for row in records if row[0] == "fpr")
        subprocess.run(
            [*command, "--import"], input=data, capture_output=True, check=True, timeout=15
        )
        exported = subprocess.check_output(
            [*command, "--export", fingerprint], stderr=subprocess.DEVNULL, timeout=15
        )
    return base64.b64encode(exported).decode(), fingerprint


def server_config(value):
    return f'''ui = false
disable_mlock = true
api_addr = "https://{value["host"]}:8200"
cluster_addr = "https://{value["host"]}:8201"
storage "raft" {{
  path = "/bao/data"
  node_id = "{value["name"]}"
}}
listener "tcp" {{
  address = "0.0.0.0:8200"
  tls_cert_file = "/tls/server.crt"
  tls_key_file = "/tls/server.key"
  tls_min_version = "tls12"
  http_read_header_timeout = "5s"
  http_read_timeout = "15s"
  http_write_timeout = "30s"
  http_idle_timeout = "30s"
  max_request_size = 1048576
  max_request_duration = "30s"
}}
audit "file" "chipload" {{
  options {{
    file_path = "/bao/audit/audit.jsonl"
    mode = "0600"
    log_raw = "false"
  }}
}}
'''


def check_tls(state):
    archive.private(state / "certificates", directory=True)
    for name in ("server.crt", "server.key", "ca.pem"):
        archive.private(state / "certificates" / name)
    ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER).load_cert_chain(
        state / "certificates/server.crt", state / "certificates/server.key"
    )
    return ssl.create_default_context(cafile=state / "certificates/ca.pem")


def configure(args):
    state = args.state.absolute()
    state.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    archive.private(state.parent, directory=True)
    if state.exists() or state.is_symlink():
        raise SecretsError("state already exists; preserve the existing secrets deployment")
    executor.runtime.docker_socket()
    executor.private_network(args.network)
    keys = [pgp_public(path) for path in args.pgp_key]
    root, fingerprint = pgp_public(args.root_pgp_key)
    value = configuration(
        {
            "version": 1,
            "image": IMAGE,
            "name": args.name,
            "network": args.network,
            "host": args.host,
            "threshold": args.threshold,
            "pgp_keys": [key for key, _ in keys],
            "fingerprints": [f for _, f in keys],
            "root_token_pgp_key": root,
            "root_fingerprint": fingerprint,
        }
    )
    owner = ownership_key(state, value)
    if ownership(value, owner) is not None:
        raise SecretsError("project already has a container; preserve its existing deployment")
    with tempfile.TemporaryDirectory(prefix=".secrets-", dir=state.parent) as temporary:
        prepared = Path(temporary) / "state"
        prepared.mkdir(mode=0o700)
        for name in ("data", "audit", "certificates"):
            (prepared / name).mkdir(mode=0o700)
        for source, name in (
            (args.certificates / "server.crt", "server.crt"),
            (args.certificates / "server.key", "server.key"),
            (args.ca_bundle, "ca.pem"),
        ):
            if name == "server.key":
                archive.private(source)
            data = source.read_bytes()
            if len(data) > 256 * 1024:
                raise SecretsError("TLS file exceeds its size limit")
            archive.write(prepared / "certificates" / name, data)
        check_tls(prepared)
        archive.write(prepared / "deployment.json", json.dumps(value, indent=2))
        archive.write(prepared / "server.hcl", server_config(value))
        archive.sync_tree(prepared)
        os.rename(prepared, state)
        archive.sync_directory(state.parent)


def ownership_key(state, value):
    return hashlib.sha256((str(state) + json.dumps(value, sort_keys=True)).encode()).hexdigest()


def ownership(value, owner):
    identifiers = subprocess.check_output(
        ["docker", "ps", "-aq", "--filter", "label=com.docker.compose.project=" + value["name"]],
        text=True,
        timeout=15,
    ).split()
    if len(identifiers) > 1:
        raise SecretsError("secrets project contains unexpected containers")
    if not identifiers:
        return None
    container = json.loads(
        subprocess.check_output(["docker", "inspect", identifiers[0]], text=True, timeout=15)
    )[0]
    if (
        container["Config"]["Labels"].get("org.chipload.secrets-owner") != owner
        or container["Config"]["Labels"].get("org.chipload.secrets-role") != "openbao"
        or container["Config"]["Labels"].get("org.chipload.secrets-sha256") != IMAGE_SHA256
        or re.fullmatch(r"sha256:[a-f0-9]{64}", container["Image"]) is None
        or container["Config"]["Image"] != container["Image"]
    ):
        raise SecretsError("Compose project belongs to a different secrets deployment")
    return container


def deployment(state):
    archive.private(state, directory=True)
    value = configuration(read_json(state / "deployment.json"))
    executor.runtime.docker_socket()
    owner = ownership_key(state, value)
    container = ownership(value, owner)
    environment = {
        **os.environ,
        "CHIPLOAD_UID": str(os.getuid()),
        "CHIPLOAD_GID": str(os.getgid()),
        "CHIPLOAD_SECRETS_STATE": str(state),
        "CHIPLOAD_SECRETS_OWNER": owner,
        "CHIPLOAD_SECRETS_HOST": value["host"],
        "CHIPLOAD_ADAPTER_NETWORK": value["network"],
        "CHIPLOAD_OPENBAO_IMAGE": container["Image"] if container else value["image"],
    }
    command = [
        "docker",
        "compose",
        "--env-file",
        "/dev/null",
        "--project-name",
        value["name"],
        "--file",
        str(ROOT / "deploy/secrets/compose.yaml"),
    ]
    return value, command, environment, container


def check_storage(state):
    for directory in ("data", "audit"):
        archive.private(state / directory, directory=True)
    for name in ("server.hcl", "deployment.json"):
        archive.private(state / name)
    if (state / "initialized.json").exists() or (state / "bootstrap.json").exists():
        # Never create an empty replacement after initialization or a wrong mount.
        for name in ("data/raft/raft.db", "data/raft/snapshots", "data/vault.db"):
            path = state / name
            if not path.exists():
                raise SecretsError(
                    "initialized OpenBao storage is incomplete; restore it before startup"
                )


def request(state, value, container, method, path, body=None, token=None, *, allowed_statuses=()):
    if container is None or not container["State"]["Running"]:
        raise SecretsError("start the secrets container before an operator request")
    address = container["NetworkSettings"]["Networks"][value["network"]]["IPAddress"]
    context = check_tls(state)
    connection = http.client.HTTPSConnection(value["host"], 8200, timeout=30, context=context)
    raw = socket.create_connection((address, 8200), timeout=5)
    try:
        connection.sock = context.wrap_socket(raw, server_hostname=value["host"])
        leaf = tls.x509.load_pem_x509_certificate((state / "certificates/server.crt").read_bytes())
        if connection.sock.getpeercert(binary_form=True) != leaf.public_bytes(
            tls.serialization.Encoding.DER
        ):
            raise ssl.SSLError("OpenBao has not loaded the configured certificate")
        connection.sock.settimeout(30)
        connection.request(
            method,
            "/v1/" + path,
            body=json.dumps(body).encode() if body is not None else None,
            headers={
                "Content-Type": "application/json",
                **({"X-Vault-Token": token} if token else {}),
            },
        )
        response = connection.getresponse()
        data = response.read(1024 * 1024 + 1)
        if len(data) > 1024 * 1024:
            raise SecretsError("OpenBao response exceeds its size limit")
        if response.status not in {200, 204, 501, 503, *allowed_statuses}:
            raise SecretsError(f"OpenBao operator request returned HTTP {response.status}")
        return response.status, json.loads(data) if data else None
    finally:
        connection.close()
        raw.close()


def compose(command, environment, *args):
    subprocess.run([*command, *args], env=environment, capture_output=True, check=True, timeout=120)


def check_identity(state, value, result):
    path = state / "initialized.json"
    if path.exists() or path.is_symlink():
        record = read_json(path)
        if record.get("version") != 1 or record.get("owner") != ownership_key(state, value):
            raise SecretsError("initialization receipt belongs to another deployment")
        if not result["initialized"]:
            raise SecretsError("initialized storage was replaced; refusing an empty OpenBao")
        if not result["sealed"]:
            identifier = result.get("cluster_id")
            if not isinstance(identifier, str) or not identifier:
                raise SecretsError("unsealed OpenBao did not identify its cluster")
            if record.get("cluster_id", identifier) != identifier:
                raise SecretsError(
                    "OpenBao cluster identity differs from its initialization receipt"
                )
            if "cluster_id" not in record:
                archive.replace_json(path, {**record, "cluster_id": identifier})


def initialize(state, value, container):
    marker = state / PENDING
    if marker.exists() or marker.is_symlink():
        if read_json(marker) != {"version": 1, "owner": ownership_key(state, value)}:
            raise SecretsError("initialization journal belongs to another deployment")
        if not (state / "bootstrap.json").exists():
            raise SecretsError(
                "initialization outcome is uncertain; preserve storage and bootstrap state; do not reinitialize"
            )
        check_storage(state)
    else:
        _, health = request(state, value, container, "GET", "sys/seal-status")
        if (state / "bootstrap.json").exists() or health["initialized"]:
            raise SecretsError(
                "OpenBao is already initialized; never replace existing bootstrap material"
            )
        archive.replace_json(marker, {"version": 1, "owner": ownership_key(state, value)})
        status, result = request(
            state,
            value,
            container,
            "POST",
            "sys/init",
            {
                "secret_shares": len(value["pgp_keys"]),
                "secret_threshold": value["threshold"],
                "pgp_keys": value["pgp_keys"],
                "root_token_pgp_key": value["root_token_pgp_key"],
            },
        )
        if status != 200 or len(result["keys_base64"]) != len(value["pgp_keys"]):
            raise SecretsError("initialization did not return the expected encrypted material")
        encrypted = [*result["keys_base64"], result["root_token"]]
        for item in encrypted:
            raw = base64.b64decode(item, validate=True)
            if len(raw) < 128 or not raw[0] & 128:
                raise SecretsError("initialization did not return PGP packets")
        archive.replace_json(
            state / "bootstrap.json",
            {
                "version": 1,
                "fingerprints": value["fingerprints"],
                "root_fingerprint": value["root_fingerprint"],
                "threshold": value["threshold"],
                "keys_base64": result["keys_base64"],
                "root_token": result["root_token"],
            },
        )
    bootstrap = read_json(state / "bootstrap.json")
    if (
        bootstrap.get("version") != 1
        or bootstrap["fingerprints"] != value["fingerprints"]
        or bootstrap["root_fingerprint"] != value["root_fingerprint"]
        or bootstrap["threshold"] != value["threshold"]
        or len(bootstrap["keys_base64"]) != len(value["pgp_keys"])
    ):
        raise SecretsError("bootstrap material does not match the initialization intent")
    archive.replace_json(
        state / "initialized.json", {"version": 1, "owner": ownership_key(state, value)}
    )
    marker.unlink()
    archive.sync_directory(state)


def operate(args):
    state = args.state.absolute()
    with tls.operation_lock(state):
        value, command, environment, container = deployment(state)
        if args.action != "down" and (
            (state / BACKUP_PENDING).exists() or (state / BACKUP_PENDING).is_symlink()
        ):
            raise SecretsError("resume the incomplete backup with scripts/secrets-recovery")
        if args.action in {"up", "reload"}:
            executor.private_network(value["network"])
            check_storage(state)
            check_tls(state)
            if (state / "server.hcl").read_text() != server_config(value):
                raise SecretsError("server configuration differs from the deployment contract")
            if (state / PENDING).exists() or (state / PENDING).is_symlink():
                raise SecretsError("resolve incomplete initialization before startup or reload")
            if args.action == "reload":
                if container is None or not container["State"]["Running"]:
                    raise SecretsError("start the service before reloading its certificates")
                compose(command, environment, "kill", "--signal", "SIGHUP", "openbao")
            else:
                environment["CHIPLOAD_OPENBAO_IMAGE"] = image_environment.resolve_image(
                    value["image"], IMAGE_SHA256
                )
                compose(command, environment, "up", "--detach")
            deadline = time.monotonic() + 45
            while True:
                container = ownership(value, ownership_key(state, value))
                try:
                    _, result = request(state, value, container, "GET", "sys/seal-status")
                    check_identity(state, value, result)
                    return {"initialized": result["initialized"], "sealed": result["sealed"]}
                except (OSError, http.client.HTTPException):
                    if time.monotonic() >= deadline:
                        raise SecretsError("secrets TLS listener did not become ready") from None
                    time.sleep(0.2)
        if args.action == "down":
            compose(command, environment, "down")
            return {"stopped": True}
        if args.action == "initialize":
            initialize(state, value, container)
            return {"initialized": True, "encrypted_material": str(state / "bootstrap.json")}
        if args.action == "unseal":
            if not (state / "initialized.json").exists() or (state / PENDING).exists():
                raise SecretsError("finish initialization before submitting unseal shares")
            if args.share_file.resolve().is_relative_to(state.resolve()):
                raise SecretsError("keep decrypted shares outside the service state directory")
            archive.private(args.share_file.parent, directory=True)
            archive.private(args.share_file)
            if args.share_file.stat().st_size > 4096:
                raise SecretsError("unseal share file exceeds its size limit")
            share = args.share_file.read_text().strip()
            if not re.fullmatch(r"[A-Za-z0-9+/=]{20,256}", share):
                raise SecretsError("unseal file must contain one share")
            status, result = request(state, value, container, "PUT", "sys/unseal", {"key": share})
            if status != 200:
                raise SecretsError("unseal request was not accepted")
            try:
                check_identity(state, value, result)
            except SecretsError:
                compose(command, environment, "stop", "openbao")
                raise
            return {key: result[key] for key in ("initialized", "sealed", "progress", "t", "n")}
        _, result = request(state, value, container, "GET", "sys/seal-status")
        check_identity(state, value, result)
        address = container["NetworkSettings"]["Networks"][value["network"]]["IPAddress"]
        return {
            **{key: result[key] for key in ("initialized", "sealed", "progress", "t", "n")},
            "operator_address": f"https://{address}:8200",
            "tls_server_name": value["host"],
            "ca_file": str(state / "certificates/ca.pem"),
        }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--state", type=Path, default=ROOT / ".local/secrets")
    actions = parser.add_subparsers(dest="action", required=True)
    setup = actions.add_parser("configure")
    setup.add_argument("--name", default="chipload-secrets")
    setup.add_argument("--network", required=True)
    setup.add_argument("--host", required=True)
    setup.add_argument("--certificates", type=Path, required=True)
    setup.add_argument("--ca-bundle", type=Path, required=True)
    setup.add_argument("--pgp-key", type=Path, action="append", required=True)
    setup.add_argument("--root-pgp-key", type=Path, required=True)
    setup.add_argument("--threshold", type=int, default=2)
    actions.add_parser("unseal").add_argument("--share-file", type=Path, required=True)
    for action in ("up", "down", "reload", "initialize", "status"):
        actions.add_parser(action)
    args = parser.parse_args()
    if os.getuid() == 0:
        parser.error("run as the non-root deployment owner")
    try:
        if args.action == "configure":
            configure(args)
            result = {"configured": str(args.state.absolute())}
        else:
            result = operate(args)
    except SecretsError as error:
        parser.exit(1, f"secrets-stack: {error}\n")
    except (
        OSError,
        ValueError,
        KeyError,
        TypeError,
        subprocess.SubprocessError,
        http.client.HTTPException,
    ):
        parser.exit(
            1,
            "secrets-stack: operation failed; preserve state and inspect configuration, TLS trust, storage and Docker health. No response or secret data is printed.\n",
        )
    print(json.dumps(result))


if __name__ == "__main__":
    main()
