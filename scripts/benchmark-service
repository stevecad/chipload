#!/usr/bin/env python3
"""Measure real loopback HTTP discovery against bounded service workers."""

import argparse
import http.client
import json
import math
import os
import platform
import runpy
import signal
import socket
import statistics
import subprocess
import sys
import tempfile
import time
import uuid
from collections import Counter
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SERVER = """import json,resource,socket,sys
resource.setrlimit(resource.RLIMIT_AS,(512*1024**2,)*2)
resource.setrlimit(resource.RLIMIT_CORE,(0,0))
import uvicorn
from chipload.auth import ServerSettings
from chipload.server import create_app
settings=ServerSettings.model_validate_json(open(sys.argv[1],'rb').read())
server=uvicorn.Server(uvicorn.Config(create_app(settings),access_log=False,log_level='error',proxy_headers=False))
server.run(sockets=[socket.socket(fileno=int(sys.argv[2]))])
"""


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--calls", type=int, default=200)
    parser.add_argument("--concurrency", type=int, default=4)
    parser.add_argument("--large-catalog", action="store_true")
    parser.add_argument(
        "--container",
        action="store_true",
        help="Run the built API image with shipped CPU/memory/process restrictions",
    )
    parser.add_argument("--policy", choices=("defaults", "capacity"), default="capacity")
    args = parser.parse_args()
    if not 1 <= args.calls <= 2000 or not 1 <= args.concurrency <= 32:
        parser.error("calls must be 1–2000 and concurrency 1–32")
    if args.container and os.getuid() == 0:
        parser.error("run the container benchmark as a non-root account")
    from chipload.auth import ServerSettings
    from chipload.lifecycle import Repository
    from chipload.quotas import QuotaPolicy
    from chipload.service_pool import MEMORY_BYTES, WALL_SECONDS, WORKERS

    runtime_image = None
    if args.container:
        runtime = runpy.run_path(str(ROOT / "scripts/runtime"))
        runtime["docker_socket"]()
        runtime_image = runtime["image"]("api")
        runtime["check_images"]({"api": runtime_image})
    fixture = runpy.run_path(str(ROOT / "scripts/benchmark-data"))
    artifact, query, at = fixture["workload"](args.large_catalog)
    with tempfile.TemporaryDirectory(prefix="chipload-service-benchmark-") as temporary:
        directory = Path(temporary)
        database = directory / "data/chipload.db"
        fixture["seed"](database, artifact, query, at)
        repository = Repository(database)
        if args.policy == "capacity":
            quota = repository.read_quotas()
            for scope in ("deployment", "peer"):
                quota["policy"]["requests"][scope] = {"per_minute": 60000, "burst": 10000}
            repository.set_quotas(
                QuotaPolicy.model_validate(quota["policy"]), expected_generation=quota["generation"]
            )
        listener = socket.socket()
        listener.bind(("127.0.0.1", 0))
        port = listener.getsockname()[1]
        settings = ServerSettings(
            mode="development",
            database=Path("/data/chipload.db") if args.container else database,
            resource_url=f"http://127.0.0.1:{port}/mcp",
            issuer="http://127.0.0.1:9/identity",
            jwks_url="http://127.0.0.1:9/keys",
        )
        configuration = directory / "settings.json"
        configuration.write_text(settings.model_dump_json())
        configuration.chmod(0o600)
        with (directory / "server.log").open("wb") as logs:
            container = "chipload-benchmark-" + uuid.uuid4().hex
            child = None
            try:
                if args.container:
                    listener.close()
                    subprocess.run(
                        [
                            "docker",
                            "run",
                            "--detach",
                            "--name",
                            container,
                            "--pull",
                            "never",
                            "--user",
                            f"{os.getuid()}:{os.getgid()}",
                            "--init",
                            "--read-only",
                            "--cap-drop",
                            "ALL",
                            "--security-opt",
                            "no-new-privileges",
                            "--memory",
                            "1g",
                            "--memory-swap",
                            "1g",
                            "--cpus",
                            "1",
                            "--pids-limit",
                            "128",
                            "--ulimit",
                            "nofile=1024:1024",
                            "--ulimit",
                            "core=0:0",
                            "--tmpfs",
                            "/tmp:rw,noexec,nosuid,nodev,size=32m,mode=1777",
                            "--log-driver",
                            "local",
                            "--log-opt",
                            "max-size=10m",
                            "--log-opt",
                            "max-file=3",
                            "--publish",
                            f"127.0.0.1:{port}:8088",
                            "--mount",
                            f"type=bind,src={database.parent},dst=/data",
                            "--mount",
                            f"type=bind,src={configuration},dst=/etc/chipload/settings.json,readonly",
                            runtime_image,
                        ],
                        check=True,
                        stdout=logs,
                        stderr=logs,
                        timeout=30,
                    )
                else:
                    child = subprocess.Popen(
                        [
                            sys.executable,
                            "-I",
                            "-B",
                            "-c",
                            SERVER,
                            str(configuration),
                            str(listener.fileno()),
                        ],
                        pass_fds=(listener.fileno(),),
                        stdout=logs,
                        stderr=logs,
                        start_new_session=True,
                    )
                    listener.close()
                for _ in range(100):
                    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=0.2)
                    try:
                        connection.request("GET", "/healthz")
                        if connection.getresponse().status == 200:
                            break
                    except OSError:
                        pass
                    finally:
                        connection.close()
                    if child is not None and child.poll() is not None:
                        raise RuntimeError("benchmark API exited during startup")
                    time.sleep(0.1)
                else:
                    raise RuntimeError("benchmark API did not become ready")
                request = json.dumps(
                    {"shop_id": "benchmark", "query": query.model_dump(mode="json")}
                ).encode()

                def call(index):
                    connection = http.client.HTTPConnection(
                        "127.0.0.1", port, timeout=WALL_SECONDS + 3
                    )
                    start = time.perf_counter()
                    status = 0
                    error_code = None
                    try:
                        evaluation = index % 4 != 0
                        path = (
                            "/v1/shops/benchmark/evaluate"
                            if evaluation
                            else "/v1/shops/benchmark/capabilities?limit=10"
                        )
                        connection.request(
                            "POST" if evaluation else "GET",
                            path,
                            body=request if evaluation else None,
                            headers={"Content-Type": "application/json"},
                        )
                        response = connection.getresponse()
                        value = json.loads(response.read())
                        status = response.status
                        if status == 200:
                            if evaluation and value["outcome"] != "supported":
                                raise AssertionError(value)
                            if not evaluation and value["items"][0]["id"] != "offer":
                                raise AssertionError(value)
                        elif status not in (429, 503):
                            raise AssertionError(value)
                        else:
                            error_code = value["error"]["code"]
                    finally:
                        connection.close()
                    return status, (time.perf_counter() - start) * 1000, error_code

                cold = call(1)
                started = time.perf_counter()
                with ThreadPoolExecutor(args.concurrency) as clients:
                    results = list(clients.map(call, range(args.calls)))
                elapsed = time.perf_counter() - started
                counts = Counter(status for status, _, _ in results)
                errors = Counter(error for _, _, error in results if error)
                accepted = [latency for status, latency, _ in results if status == 200]
                print(
                    json.dumps(
                        {
                            "client_python": platform.python_version(),
                            "runtime": runtime_image
                            if args.container
                            else platform.python_version(),
                            "container_limits": {"cpus": 1, "memory_bytes": 1024**3, "pids": 128}
                            if args.container
                            else None,
                            "platform": platform.platform(),
                            "workload": "large-catalog" if args.large_catalog else "compact",
                            "artifact_bytes": len(artifact.to_json()),
                            "mix": "75% workflow evaluation, 25% capability page",
                            "policy": args.policy,
                            "calls": args.calls,
                            "concurrency": args.concurrency,
                            "service_workers": WORKERS,
                            "worker_address_space_bytes": MEMORY_BYTES,
                            "worker_wall_seconds": WALL_SECONDS,
                            "cold_call": {
                                "status": cold[0],
                                "ms": round(cold[1], 3),
                                "error": cold[2],
                            },
                            "status_counts": dict(counts),
                            "error_counts": dict(errors),
                            "elapsed_seconds": round(elapsed, 3),
                            "accepted_per_second": round(len(accepted) / elapsed, 3),
                            "accepted_median_ms": round(statistics.median(accepted), 3)
                            if accepted
                            else None,
                            "accepted_p95_ms": round(
                                sorted(accepted)[math.ceil(0.95 * len(accepted)) - 1], 3
                            )
                            if accepted
                            else None,
                            "scope": "Real loopback HTTP, shared admission, SQLite, projection and service workers; excludes TLS/JWT and external networks. Container limits apply only with --container.",
                        },
                        indent=2,
                    )
                )
            finally:
                listener.close()
                if args.container:
                    subprocess.run(
                        ["docker", "rm", "--force", container],
                        stdout=logs,
                        stderr=logs,
                        check=True,
                        timeout=30,
                    )
                elif child is not None:
                    child.terminate()
                    try:
                        child.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        os.killpg(child.pid, signal.SIGKILL)
                        child.wait(timeout=3)


if __name__ == "__main__":
    main()
