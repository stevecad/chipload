#!/usr/bin/env python3
"""Keycloak device login and subject-bound OpenBao operator grants."""

import argparse
import hashlib
import http.client

# The operator tools share transport, custody, and deployment locking rules.
import importlib.machinery
import importlib.util
import json
import os
import re
import socket
import ssl
import time
import uuid
from contextlib import ExitStack
from pathlib import Path
from urllib.parse import parse_qs, urlencode, urlsplit

import jwt
import recovery_archive as archive
from cryptography.hazmat.primitives import serialization

ROOT = Path(__file__).resolve().parents[1]
loader = importlib.machinery.SourceFileLoader(
    "identity_secrets_stack", str(ROOT / "scripts/secrets-stack")
)
stack = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(stack)
workload = stack.load("identity_workload", "scripts/secrets-workload")
credentials = stack.load("identity_credentials", "scripts/tls-credentials")
MOUNT = "chipload-operators"
MARKER = ".secrets-identity-incomplete.json"
RECEIPT = "operator-identity.json"
TTL = 300


class IdentityError(ValueError):
    """Fixed diagnostic without identity-provider response bodies or bearer tokens."""


def name(value):
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,47}", value):
        raise IdentityError(
            "use an operator grant name of 1–48 lowercase letters, digits or hyphens"
        )
    return value


def issuer(values):
    return stack.tls.origin(values["identity_host"], values["port"]) + "/realms/chipload"


def owner(state, identity_state):
    return hashlib.sha256(
        (
            str(state) + str(identity_state) + archive.digest(identity_state / "deployment.json")
        ).encode()
    ).hexdigest()


def read_token(path):
    archive.private(path.parent, directory=True)
    archive.private(path)
    if path.stat().st_size > 64 * 1024:
        raise IdentityError("token file exceeds its size limit")
    value = path.read_text().strip()
    if not value or any(c.isspace() for c in value):
        raise IdentityError("provide one token in a private file")
    return value


def public_keys(jwks):
    keys = {}
    if not isinstance(jwks, dict) or not 1 <= len(jwks.get("keys", [])) <= 32:
        raise IdentityError("identity provider returned an invalid key set")
    for item in jwks["keys"]:
        if item.get("use") != "sig" or item.get("alg") != "RS256":
            continue
        if (
            item.get("kty") != "RSA"
            or not isinstance(item.get("kid"), str)
            or item["kid"] in keys
            or "d" in item
        ):
            raise IdentityError("identity provider returned an invalid RSA signing key")
        key = jwt.PyJWK.from_dict(item).key
        if key.key_size < 2048:
            raise IdentityError("identity signing keys must be at least 2048 bits")
        keys[item["kid"]] = (
            key.public_bytes(
                serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo
            )
            .decode()
            .strip()
        )
    if not keys:
        raise IdentityError("identity provider has no acceptable RS256 signing key")
    return dict(sorted(keys.items()))


def outside_services(path, state, identity_state):
    target = path.resolve()
    directories = [state.resolve(), identity_state.resolve()]
    for receipt in (state / "workloads").glob("*.json"):
        directories.append(Path(stack.read_json(receipt)["credentials"]).resolve())
    if any(target.is_relative_to(directory) for directory in directories):
        raise IdentityError("keep operator token files outside service and workload directories")


def client_config(identity):
    return {
        "id": identity["client_uuid"],
        "clientId": identity["client_id"],
        "protocol": "openid-connect",
        "enabled": True,
        "publicClient": True,
        "standardFlowEnabled": False,
        "directAccessGrantsEnabled": False,
        "serviceAccountsEnabled": False,
        "implicitFlowEnabled": False,
        "fullScopeAllowed": False,
        "defaultClientScopes": [],
        "optionalClientScopes": [],
        "redirectUris": [],
        "attributes": {
            "oauth2.device.authorization.grant.enabled": "true",
            "access.token.lifespan": "120",
        },
        "protocolMappers": [
            {
                "name": "secrets-audience",
                "protocol": "openid-connect",
                "protocolMapper": "oidc-audience-mapper",
                "config": {
                    "included.custom.audience": identity["audience"],
                    "access.token.claim": "true",
                    "id.token.claim": "false",
                    "userinfo.token.claim": "false",
                },
            },
            {
                "name": "secrets-grants",
                "protocol": "openid-connect",
                "protocolMapper": "oidc-usermodel-client-role-mapper",
                "config": {
                    "usermodel.clientRoleMapping.clientId": identity["client_id"],
                    "claim.name": "chipload_operator_roles",
                    "jsonType.label": "String",
                    "multivalued": "true",
                    "access.token.claim": "true",
                    "id.token.claim": "false",
                    "userinfo.token.claim": "false",
                },
            },
            {
                "name": "secrets-subject",
                "protocol": "openid-connect",
                "protocolMapper": "oidc-sub-mapper",
                "config": {
                    "access.token.claim": "true",
                    "id.token.claim": "false",
                    "userinfo.token.claim": "false",
                },
            },
        ],
    }


def jwt_config(identity):
    return {
        "jwt_validation_pubkeys": list(identity["keys"].values()),
        "bound_issuer": identity["issuer"],
        "jwt_supported_algs": ["RS256"],
        "default_role": "",
    }


def role_config(identity, grant):
    return {
        "role_type": "jwt",
        "user_claim": "sub",
        "bound_subject": grant["subject"],
        "bound_audiences": [identity["audience"]],
        "bound_claims_type": "string",
        "bound_claims": {
            "azp": identity["client_id"],
            "typ": "Bearer",
            "chipload_operator_roles": grant["role"],
        },
        "clock_skew_leeway": -1,
        "expiration_leeway": -1,
        "not_before_leeway": -1,
        "token_policies": [grant["policy"]],
        "token_no_default_policy": True,
        "token_ttl": TTL,
        "token_max_ttl": TTL,
        "token_explicit_max_ttl": TTL,
        "token_type": "service",
        "token_period": 0,
        "claim_mappings": {"sub": "subject", "azp": "client"},
    }


def policy(grant):
    if grant["administrator"]:
        return 'path "*" { capabilities = ["create", "read", "update", "delete", "list", "sudo"] }'
    paths = {
        "auth/token/lookup-self": ["read"],
        "auth/token/revoke-self": ["update"],
        "sys/capabilities": ["update"],
    }
    for profile in grant["workloads"]:
        acl = "sys/policies/acl/" + profile["name"]
        role = f"auth/{profile['auth_mount']}/role/{profile['name']}"
        paths[acl] = ["read"]
        paths[role] = ["read"]
        paths[role + "/role-id"] = ["read"]
        for suffix in ("secret-id/lookup", "custom-secret-id", "secret-id/destroy"):
            paths[role + "/" + suffix] = ["update"]
    return "\n".join(
        f'path "{path}" {{ capabilities = {json.dumps(caps)} }}'
        for path, caps in sorted(paths.items())
    )


class Provider:
    def __init__(self, state, token=None):
        self.state = state
        self.values = stack.tls.configuration(stack.read_json(state / "deployment.json"))
        stack.tls.require_ready(state)
        self.token = token

    def request(self, path, *, method="GET", data=None, admin=False, expected=(200,)):
        status, result = credentials.request(
            self.state,
            self.values,
            path,
            method=method,
            data=data,
            token=self.token if admin else None,
            admin=admin,
        )
        if status not in expected:
            raise IdentityError(f"identity provider rejected the operator request (HTTP {status})")
        return status, result

    def admin(self, path, **kwargs):
        return self.request("/admin/realms/chipload" + path, admin=True, **kwargs)

    def keys(self):
        return public_keys(self.request("/realms/chipload/protocol/openid-connect/certs")[1])


def same_client(actual, expected):
    for field in expected:
        if field == "protocolMappers":
            without_id = [
                {k: v for k, v in m.items() if k not in {"id", "consentRequired"}}
                for m in actual.get(field, [])
            ]
            if sorted(without_id, key=lambda m: m["name"]) != sorted(
                expected[field], key=lambda m: m["name"]
            ):
                return False
        elif field == "attributes":
            if any(actual.get(field, {}).get(k) != v for k, v in expected[field].items()):
                return False
        elif actual.get(field) != expected[field]:
            return False
    return True


def ensure_client(provider, identity):
    path = "/clients/" + identity["client_uuid"]
    expected = client_config(identity)
    status, actual = provider.admin(path, expected=(200, 404))
    if status == 404:
        provider.admin("/clients", method="POST", data=expected, expected=(201,))
        actual = provider.admin(path)[1]
    if not same_client(actual, expected):
        fields = [field for field in expected if not same_client(actual, {field: expected[field]})]
        raise IdentityError("operator client contract differs in: " + ", ".join(fields))
    return path


def save_pending(state, identity_state, journal):
    # Both copies contain public intent only. Either copy can finish a lost local write.
    if len(json.dumps(journal).encode()) > 1024 * 1024:
        raise IdentityError("operator configuration journal exceeds its limit")
    archive.replace_json(state / MARKER, journal)
    archive.replace_json(identity_state / MARKER, journal)


def pending(state, identity_state):
    copies = [
        stack.read_json(root / MARKER)
        for root in (state, identity_state)
        if (root / MARKER).exists() or (root / MARKER).is_symlink()
    ]
    if not copies:
        return None
    if any(copy != copies[0] for copy in copies) or copies[0].get("owner") != owner(
        state, identity_state
    ):
        raise IdentityError("operator configuration journal does not match these deployments")
    return copies[0]


def finish(state, identity_state):
    for root in (state, identity_state):
        (root / MARKER).unlink(missing_ok=True)
        archive.sync_directory(root)


def assert_identity(api, provider, identity):
    if (
        identity.get("version") != 1
        or identity["cluster_id"] != api.cluster
        or identity["issuer"] != issuer(provider.values)
    ):
        raise IdentityError("operator identity belongs to another secrets cluster or issuer")


def require_subject(provider, subject):
    user = provider.admin("/users/" + subject)[1]
    if (
        user.get("id") != subject
        or user.get("enabled") is not True
        or user.get("serviceAccountClientId")
    ):
        raise IdentityError("operator grant requires an enabled human Keycloak subject")


def configure(api, provider, journal):
    identity, grant = journal["identity"], journal.get("grant")
    assert_identity(api, provider, identity)
    client_path = ensure_client(provider, identity)
    mounts = api.call("GET", "sys/auth")[1]["data"]
    if MOUNT + "/" not in mounts:
        api.call("POST", "sys/auth/" + MOUNT, {"type": "jwt"})
    elif mounts[MOUNT + "/"]["type"] != "jwt":
        raise IdentityError("operator authentication mount has a different type")
    if journal["action"] in {"grant", "sync-keys"}:
        status, previous = api.call("GET", f"auth/{MOUNT}/config", statuses=(200, 204, 404))
        allowed = [jwt_config(identity)]
        if (api.state / RECEIPT).exists():
            allowed.append(jwt_config(stack.read_json(api.state / RECEIPT)))
        if status == 200 and not any(
            all(previous["data"].get(k) == v for k, v in expected.items()) for expected in allowed
        ):
            raise IdentityError("operator JWT trust changed outside this configuration")
        api.call("POST", f"auth/{MOUNT}/config", jwt_config(identity))
        actual = api.call("GET", f"auth/{MOUNT}/config")[1]["data"]
        if any(actual.get(k) != v for k, v in jwt_config(identity).items()):
            raise IdentityError("operator JWT trust configuration did not match")
    if grant:
        keycloak_role = client_path + "/roles/" + grant["role"]
        user_path = "/users/" + grant["subject"]
        mapping = user_path + "/role-mappings/clients/" + identity["client_uuid"]
        acl = "sys/policies/acl/" + grant["policy"]
        role_path = f"auth/{MOUNT}/role/{grant['name']}"
        if journal["action"] == "revoke":
            api.call("PUT", acl, {"policy": workload.REVOKED_POLICY})
            if api.call("GET", acl)[1]["data"]["policy"] != workload.REVOKED_POLICY:
                raise IdentityError("operator policy revocation was not verified")
            api.call("DELETE", role_path)
            if api.call("GET", role_path, statuses=(200, 404))[0] != 404:
                raise IdentityError("operator role deletion was not verified")
            status, role = provider.admin(keycloak_role, expected=(200, 404))
            if status == 200:
                provider.admin(mapping, method="DELETE", data=[role], expected=(204, 404))
            grant = {**grant, "status": "revoked"}
        else:
            require_subject(provider, grant["subject"])
            status, role = provider.admin(keycloak_role, expected=(200, 404))
            if status == 404:
                provider.admin(
                    client_path + "/roles",
                    method="POST",
                    data={"name": grant["role"]},
                    expected=(201,),
                )
                role = provider.admin(keycloak_role)[1]
            provider.admin(
                client_path + "/scope-mappings/clients/" + identity["client_uuid"],
                method="POST",
                data=[role],
                expected=(204,),
            )
            provider.admin(mapping, method="POST", data=[role], expected=(204,))
            if grant["role"] not in {r["name"] for r in provider.admin(mapping)[1]}:
                raise IdentityError("Keycloak operator assignment was not verified")
            for path, data in (
                (acl, {"policy": policy(grant)}),
                (role_path, role_config(identity, grant)),
            ):
                api.call("POST", path, data)
                actual = api.call("GET", path)[1]["data"]
                if any(actual.get(k) != v for k, v in data.items()):
                    raise IdentityError("operator authorization did not match its intent")
            grant = {**grant, "status": "active"}
        directory = api.state / "operators"
        directory.mkdir(mode=0o700, exist_ok=True)
        archive.private(directory, directory=True)
        archive.replace_json(directory / (grant["name"] + ".json"), grant)
    archive.replace_json(api.state / RECEIPT, identity)
    finish(api.state, provider.state)
    return {
        "configured": True,
        "grant": grant["name"] if grant else None,
        "status": grant["status"] if grant else "keys-synchronized",
        "key_ids": list(identity["keys"]),
    }


def prepare(api, provider, args):
    path = api.state / RECEIPT
    if path.exists() or path.is_symlink():
        identity = stack.read_json(path)
        assert_identity(api, provider, identity)
    else:
        if args.action != "grant":
            raise IdentityError("configure an operator grant first")
        identity = {
            "version": 1,
            "cluster_id": api.cluster,
            "issuer": issuer(provider.values),
            "client_id": "chipload-secrets-" + api.cluster,
            "client_uuid": str(uuid.uuid4()),
            "audience": "urn:chipload:secrets:" + api.cluster,
            "keys": provider.keys(),
        }
        if api.call("GET", "sys/auth")[1]["data"].get(MOUNT + "/"):
            raise IdentityError("operator authentication mount already exists without a receipt")
        if provider.admin("/clients?" + urlencode({"clientId": identity["client_id"]}))[1]:
            raise IdentityError("operator client already exists without a receipt")
    grant = None
    if args.action == "sync-keys":
        identity = {**identity, "keys": provider.keys()}
    else:
        identifier = name(args.name)
        receipt = api.state / "operators" / (identifier + ".json")
        if args.action == "revoke":
            grant = stack.read_json(receipt)
            if grant["name"] != identifier or grant["status"] != "active":
                raise IdentityError("operator grant is not active or does not match its receipt")
        else:
            if receipt.exists() or receipt.is_symlink():
                raise IdentityError(
                    "operator name is already reserved; revoke old grants and use a new name"
                )
            subject = str(uuid.UUID(args.subject))
            require_subject(provider, subject)
            profiles = []
            for workload_id in args.workload:
                if not re.fullmatch(r"[a-z][a-z0-9-]{0,63}", workload_id):
                    raise IdentityError("invalid workload name")
                profile = stack.read_json(api.state / "workloads" / (workload_id + ".json"))
                if profile.get("name") != workload_id:
                    raise IdentityError("workload receipt belongs to another identity")
                profiles.append(profile)
            if bool(args.administrator) == bool(profiles) or len(profiles) > 64:
                raise IdentityError("choose administrator access or 1–64 named workloads")
            for profile in profiles:
                workload.validate_profile(api, profile)
                if profile["status"] != "active":
                    raise IdentityError("rotation grants require active managed workloads")
            grant = {
                "version": 1,
                "name": identifier,
                "subject": subject,
                "administrator": args.administrator,
                "workloads": [
                    {
                        "name": p["name"],
                        "auth_mount": p["adapter"]["secrets"].get("auth_mount", "approle"),
                    }
                    for p in profiles
                ],
                "policy": "chipload-operator-" + identifier,
                "role": "operator-" + identifier,
            }
            for endpoint in (
                "sys/policies/acl/" + grant["policy"],
                f"auth/{MOUNT}/role/{identifier}",
            ):
                if api.call("GET", endpoint, statuses=(200, 404))[0] != 404:
                    raise IdentityError("operator policy or role already exists")
    return {
        "version": 1,
        "owner": owner(api.state, provider.state),
        "action": args.action,
        "identity": identity,
        "grant": grant,
    }


def device_request(provider, path, data):
    """Device and token endpoints use forms; keep TLS naming and connection routing pinned."""
    host, port = provider.values["identity_host"], provider.values["port"]
    context = ssl.create_default_context(cafile=provider.state / "identity-ca.pem")
    connection = http.client.HTTPSConnection(host, port, timeout=15, context=context)
    raw = socket.create_connection((stack.tls.connect_address(provider.values), port), timeout=15)
    try:
        connection.sock = context.wrap_socket(raw, server_hostname=host)
        connection.request(
            "POST",
            path,
            body=urlencode(data),
            headers={"Content-Type": "application/x-www-form-urlencoded"},
        )
        response = connection.getresponse()
        body = response.read(1024 * 1024 + 1)
        if len(body) > 1024 * 1024 or response.status not in {200, 400}:
            raise IdentityError("device login request failed")
        return response.status, json.loads(body)
    finally:
        connection.close()
        raw.close()


def device_login(provider, identity, *, announce=print, sleep=time.sleep):
    base = "/realms/chipload/protocol/openid-connect"
    status, result = device_request(
        provider, base + "/auth/device", {"client_id": identity["client_id"], "scope": "openid"}
    )
    if status != 200:
        raise IdentityError("device login was rejected")
    url = result["verification_uri"]
    if urlsplit(url)._replace(path="", query="", fragment="").geturl() != identity[
        "issuer"
    ].removesuffix("/realms/chipload") or not url.startswith(identity["issuer"] + "/"):
        raise IdentityError("device verification address differs from the configured issuer")
    code, interval, expires = result["user_code"], result.get("interval", 5), result["expires_in"]
    if (
        not isinstance(code, str)
        or not re.fullmatch(r"[A-Za-z0-9-]{4,32}", code)
        or type(interval) is not int
        or not 1 <= interval <= 30
        or type(expires) is not int
        or not 1 <= expires <= 900
    ):
        raise IdentityError("device login response exceeded its limits")
    complete = result.get("verification_uri_complete")
    if complete is not None:
        parsed = urlsplit(complete)
        if (
            parsed._replace(query="", fragment="").geturl() != url
            or parsed.fragment
            or parse_qs(parsed.query, strict_parsing=True) != {"user_code": [code]}
        ):
            raise IdentityError("device verification link differs from the requested code")
        url = complete
    announce(
        f"Open {url} and confirm code {code}. Approve this request only if you started it.",
        flush=True,
    )
    deadline = time.monotonic() + expires
    while time.monotonic() < deadline:
        sleep(min(interval, max(0, deadline - time.monotonic())))
        status, token = device_request(
            provider,
            base + "/token",
            {
                "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
                "client_id": identity["client_id"],
                "device_code": result["device_code"],
            },
        )
        if status == 200:
            return token["access_token"]
        if token.get("error") == "slow_down":
            interval += 5
        elif token.get("error") != "authorization_pending":
            raise IdentityError("device login was denied or expired")
    raise IdentityError("device login expired")


def check_jwt(identity, grant, token):
    if len(token) > 64 * 1024:
        raise IdentityError("access token exceeds its limit")
    header = jwt.get_unverified_header(token)
    key = identity["keys"].get(header.get("kid"))
    if header.get("alg") != "RS256" or key is None:
        raise IdentityError("access-token signing key is not synchronized")
    claims = jwt.decode(
        token,
        key,
        algorithms=["RS256"],
        audience=identity["audience"],
        issuer=identity["issuer"],
        options={"require": ["exp", "iat", "sub", "azp", "typ"]},
    )
    roles = claims.get("chipload_operator_roles")
    if (
        claims["sub"] != grant["subject"]
        or claims["azp"] != identity["client_id"]
        or claims["typ"] != "Bearer"
        or not isinstance(roles, list)
        or grant["role"] not in roles
        or not 0 < claims["exp"] - claims["iat"] <= 120
    ):
        raise IdentityError("access token does not match this operator grant")


def login_configuration(state, identity_state, identifier):
    journal = pending(state, identity_state)
    identity = stack.read_json(state / RECEIPT)
    grant = stack.read_json(state / "operators" / (name(identifier) + ".json"))
    if grant["name"] != identifier or grant["status"] != "active":
        raise IdentityError("operator grant is not active or does not match")
    if journal:
        if (journal.get("grant") or {}).get("name") == identifier:
            raise IdentityError("use another completed grant while this operator change is pending")
        if journal["action"] == "sync-keys":
            # A committed trust update may have lost its response. OpenBao still
            # decides which keys it accepts; completed grants alone authorize login.
            identity = journal["identity"]
    return identity, grant, journal


def login(args):
    state, identity_state = args.state.absolute(), args.identity_state.absolute()
    configuration = login_configuration(state, identity_state, args.name)
    identity, grant, _ = configuration
    provider = Provider(identity_state)
    if identity["issuer"] != issuer(provider.values):
        raise IdentityError("operator identity issuer does not match")
    output = args.output.absolute()
    outside_services(output, state, identity_state)
    archive.private(output.parent, directory=True)
    if (
        output.exists()
        or output.is_symlink()
        or output.resolve().is_relative_to(state)
        or output.resolve().is_relative_to(identity_state)
    ):
        raise IdentityError("save the operator token to a new private file outside service state")
    token = read_token(args.jwt_file) if args.jwt_file else device_login(provider, identity)
    check_jwt(identity, grant, token)
    with stack.tls.operation_lock(state):
        if any(
            (state / marker).exists() or (state / marker).is_symlink()
            for marker in (stack.PENDING, stack.BACKUP_PENDING)
        ):
            raise IdentityError("finish secrets initialization or backup before operator login")
        if login_configuration(state, identity_state, args.name) != configuration:
            raise IdentityError("operator grant changed while authenticating; log in again")
        value, _, _, container = stack.deployment(state)
        _, health = stack.request(state, value, container, "GET", "sys/seal-status")
        stack.check_identity(state, value, health)
        if health.get("cluster_id") != identity["cluster_id"]:
            raise IdentityError("unseal the configured secrets cluster before login")
        status, response = stack.request(
            state,
            value,
            container,
            "POST",
            f"auth/{MOUNT}/login",
            {"role": args.name, "jwt": token},
        )
        auth = response["auth"] if status == 200 else {}
        issued = workload.token_value(auth.get("client_token"))
        try:
            if (
                auth.get("policies") != [grant["policy"]]
                or auth.get("identity_policies")
                or not 0 < auth["lease_duration"] <= TTL
            ):
                raise IdentityError("operator token exceeded its scope or lifetime")
            archive.write(output, issued + "\n")
            archive.sync_directory(output.parent)
        except BaseException:
            stack.request(state, value, container, "POST", "auth/token/revoke-self", token=issued)
            raise
    return {
        "token_file": str(output),
        "subject": grant["subject"],
        "grant": grant["name"],
        "expires_in": auth["lease_duration"],
    }


def operate(args):
    if args.action == "login":
        return login(args)
    state, identity_state = args.state.absolute(), args.identity_state.absolute()
    if state == identity_state:
        raise IdentityError("identity and secrets deployments must use separate state")
    outside_services(args.operator_token, state, identity_state)
    outside_services(args.keycloak_token, state, identity_state)
    with ExitStack() as locks:
        for root in sorted((state, identity_state)):
            locks.enter_context(stack.tls.operation_lock(root))
        api = workload.API(state, args.operator_token.absolute())
        provider = Provider(identity_state, read_token(args.keycloak_token))
        journal = pending(state, identity_state)
        if journal is None:
            if args.action == "resume":
                raise IdentityError("there is no pending operator configuration")
            journal = prepare(api, provider, args)
        elif args.action != "resume":
            raise IdentityError("resume the existing operator configuration before another change")
        save_pending(state, identity_state, journal)
        return configure(api, provider, journal)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--state", type=Path, default=ROOT / ".local/secrets")
    parser.add_argument("--identity-state", type=Path, required=True)
    parser.add_argument("--operator-token", type=Path)
    parser.add_argument("--keycloak-token", type=Path)
    actions = parser.add_subparsers(dest="action", required=True)
    grant = actions.add_parser("grant")
    grant.add_argument("--name", required=True)
    grant.add_argument("--subject", required=True)
    grant.add_argument("--administrator", action="store_true")
    grant.add_argument("--workload", action="append", default=[])
    actions.add_parser("revoke").add_argument("--name", required=True)
    actions.add_parser("sync-keys")
    actions.add_parser("resume")
    action = actions.add_parser("login")
    action.add_argument("--name", required=True)
    action.add_argument("--output", type=Path, required=True)
    action.add_argument("--jwt-file", type=Path)
    args = parser.parse_args()
    if os.getuid() == 0:
        parser.error("run as the non-root deployment owner")
    if args.action != "login" and not (args.operator_token and args.keycloak_token):
        parser.error(
            "configuration requires private OpenBao and Keycloak administrative token files"
        )
    try:
        result = operate(args)
    except IdentityError as error:
        parser.exit(1, f"secrets-identity: {error}\n")
    except Exception:
        parser.exit(
            1,
            "secrets-identity: operation failed; preserve configuration journals and check service health, trust and administrative permissions. No token or response data is printed.\n",
        )
    print(json.dumps(result))


if __name__ == "__main__":
    main()
