#!/usr/bin/env python3
"""Provision, verify, rotate and revoke one adapter's private OpenBao workload identity."""

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import secrets
import tempfile
import time
from pathlib import Path

import recovery_archive as archive

from chipload.remote_adapter import HttpAdapterConfig, private_bytes, token_value

ROOT = Path(__file__).resolve().parents[1]
loader = importlib.machinery.SourceFileLoader(
    "workload_secrets_stack", str(ROOT / "scripts/secrets-stack")
)
stack = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(stack)
PENDING = stack.WORKLOAD_PENDING
REVOKED_POLICY = 'path "*" { capabilities = ["deny"] }'
TOKEN_TTL = 60


class WorkloadError(ValueError):
    """Fixed operator diagnostic without credential or server response contents."""


def read_secret(path):
    archive.private(path.parent, directory=True)
    return token_value(private_bytes(path, 4096).decode("ascii").strip())


def digest_secret(value):
    return hashlib.sha256(value.encode()).hexdigest()


def policy(profile):
    config = HttpAdapterConfig.model_validate(profile["adapter"]).secrets
    return (
        f'path "{config.kv_mount}/data/{config.secret_path}" {{ capabilities = ["read"] }}\n'
        'path "auth/token/revoke-self" { capabilities = ["update"] }'
    )


def role_config(profile):
    return {
        "bind_secret_id": True,
        "secret_id_num_uses": 0,
        "secret_id_ttl": profile["secret_id_ttl"],
        "token_policies": [profile["name"]],
        "token_no_default_policy": True,
        "token_ttl": TOKEN_TTL,
        "token_max_ttl": TOKEN_TTL,
        "token_explicit_max_ttl": TOKEN_TTL,
        "token_period": 0,
        "token_num_uses": 0,
        "token_type": "service",
        "secret_id_bound_cidrs": [],
        "token_bound_cidrs": [],
    }


def addresses(profile):
    config = HttpAdapterConfig.model_validate(profile["adapter"]).secrets
    return (
        f"sys/policies/acl/{profile['name']}",
        f"auth/{config.auth_mount}/role/{profile['name']}",
        f"{config.kv_mount}/data/{config.secret_path}",
    )


class API:
    def __init__(self, state, token_file):
        self.state = state
        self.operator_token = token_file.resolve()
        self.value, _, _, self.container = stack.deployment(state)
        if any(
            (state / name).exists() or (state / name).is_symlink()
            for name in (stack.PENDING, stack.BACKUP_PENDING)
        ):
            raise WorkloadError("complete initialization or backup before workload changes")
        if token_file.resolve().is_relative_to(state):
            raise WorkloadError("keep the operator token outside secrets service state")
        self.token = read_secret(token_file)
        health = self.call("GET", "sys/seal-status", token=None)[1]
        stack.check_identity(state, self.value, health)
        if not health["initialized"] or health["sealed"]:
            raise WorkloadError("unseal the secrets service before managing workloads")
        self.cluster = stack.read_json(state / "initialized.json")["cluster_id"]

    def call(self, method, path, body=None, *, token=True, statuses=(200, 204)):
        status, result = stack.request(
            self.state,
            self.value,
            self.container,
            method,
            path,
            body,
            self.token if token is True else token,
            allowed_statuses=statuses,
        )
        if status not in statuses:
            raise WorkloadError("OpenBao rejected the workload request")
        return status, result


def credential_directory(state, profile, *, initial=False):
    directory = Path(profile["credentials"])
    if directory != directory.resolve() or directory.is_relative_to(state):
        raise WorkloadError(
            "keep workload credentials in a canonical directory outside secrets state"
        )
    archive.private(directory, directory=True)
    archive.private(directory.parent, directory=True)
    if directory.stat().st_dev != directory.parent.stat().st_dev:
        raise WorkloadError("credential directory and its private parent must share a filesystem")
    definition = HttpAdapterConfig.model_validate(profile["adapter"])
    ca_files = {definition.ca_file, definition.secrets.ca_file} - {None}
    if ca_files & {"role-id", "secret-id"}:
        raise WorkloadError("CA files cannot use workload credential filenames")
    names = {p.name for p in directory.iterdir()}
    if not ca_files <= names or not names <= ca_files | {"role-id", "secret-id"}:
        raise WorkloadError("credential directory must contain only its CA and workload files")
    if initial and names != ca_files:
        raise WorkloadError("new workloads require a credential directory containing only CA files")
    for name in names:
        private_bytes(directory / name, 256 * 1024 if name in ca_files else 4096)
    if (
        definition.secrets.ca_file is None
        or (directory / definition.secrets.ca_file).read_bytes()
        != (state / "certificates/ca.pem").read_bytes()
    ):
        raise WorkloadError("workload OpenBao trust must match the managed service CA")
    return directory


def validate_profile(api, profile, *, check_credentials=True):
    definition = HttpAdapterConfig.model_validate(profile["adapter"])
    if api.operator_token.is_relative_to(Path(profile["credentials"]).resolve()):
        raise WorkloadError("keep the operator token outside workload credential directories")
    if (
        profile.get("version") != 1
        or profile.get("cluster_id") != api.cluster
        or profile.get("name") != definition.secrets.policy
        or definition.secrets.origin != f"https://{api.value['host']}:8200"
        or type(profile.get("secret_id_ttl")) is not int
        or not 300 <= profile["secret_id_ttl"] <= 7 * 86400
    ):
        raise WorkloadError("workload profile does not match this service or lifetime bounds")
    if definition.secrets.auth_mount.split("/")[0] in {
        "token",
        "sys",
        "identity",
    } or definition.secrets.kv_mount.split("/")[0] in {"sys", "auth", "identity", "cubbyhole"}:
        raise WorkloadError("use dedicated AppRole and KV mounts")
    if check_credentials:
        credential_directory(api.state, profile)


def assert_config(api, profile):
    acl, role, _ = addresses(profile)
    actual = api.call("GET", acl)[1]["data"]["policy"]
    if actual != policy(profile):
        raise WorkloadError("managed workload policy changed; refusing to broaden or overwrite it")
    data = api.call("GET", role)[1]["data"]
    for name, expected in role_config(profile).items():
        actual = data.get(name)
        if expected == [] and actual is None:
            actual = []
        if actual != expected:
            raise WorkloadError(
                "managed AppRole settings changed; review its permissions before continuing"
            )
    return token_value(api.call("GET", role + "/role-id")[1]["data"]["role_id"])


def lookup(api, profile, secret):
    role = addresses(profile)[1]
    status, result = api.call(
        "POST", role + "/secret-id/lookup", {"secret_id": secret}, statuses=(200, 204, 404)
    )
    return result["data"] if status == 200 else None


def verify_login(api, profile, role_id, secret_id):
    config = HttpAdapterConfig.model_validate(profile["adapter"]).secrets
    result = api.call(
        "POST",
        f"auth/{config.auth_mount}/login",
        {"role_id": role_id, "secret_id": secret_id},
        token=None,
    )[1]
    auth = result["auth"]
    token = token_value(auth["client_token"])
    try:
        if (
            auth.get("policies") != [profile["name"]]
            or auth.get("identity_policies")
            or not 0 < auth["lease_duration"] <= TOKEN_TTL
        ):
            raise WorkloadError("workload login exceeded its permission or lifetime contract")
        path = addresses(profile)[2]
        data = api.call("GET", path, token=token)[1]["data"]
        if data["metadata"].get("destroyed") is not False or data["metadata"].get("deletion_time"):
            raise WorkloadError("workload secret version is not active")
        token_value(data["data"][config.field])
        # Non-mutating ACL queries cover forbidden writes; actual denied reads/list/admin
        # verify policy enforcement without risking a credential write under a bad policy.
        denied = [
            path + "/outside",
            f"{config.kv_mount}/metadata/{config.secret_path}",
            "sys/mounts",
        ]
        capabilities = api.call(
            "POST", "sys/capabilities", {"token": token, "paths": [path, *denied]}
        )[1]
        if capabilities[path] != ["read"] or any(capabilities[name] != ["deny"] for name in denied):
            raise WorkloadError("workload capabilities exceed the exact secret read")
        for method, name in (("GET", denied[0]), ("LIST", denied[1]), ("GET", denied[2])):
            status, _ = api.call(method, name, token=token, statuses=(200, 403, 404))
            if status != 403:
                raise WorkloadError("workload access denial was not verified")
        return data["metadata"]["version"]
    finally:
        api.call("POST", "auth/token/revoke-self", token=token)


def assert_denied_login(api, profile, role_id, secret_id):
    config = HttpAdapterConfig.model_validate(profile["adapter"]).secrets
    status, result = api.call(
        "POST",
        f"auth/{config.auth_mount}/login",
        {"role_id": role_id, "secret_id": secret_id},
        token=None,
        statuses=(200, 400, 403),
    )
    if status == 200:
        api.call("POST", "auth/token/revoke-self", token=result["auth"]["client_token"])
        raise WorkloadError("retired workload credential still authenticates")


def save_pending(api, pending):
    archive.replace_json(api.state / PENDING, pending)


def install_file(path, value, previous=None):
    if path.exists() or path.is_symlink():
        existing = read_secret(path)
        if existing == value:
            return
        if previous is None or digest_secret(existing) != previous:
            raise WorkloadError("workload file changed outside this operation")
    # Stage outside the mounted credential directory; interrupted staging must not
    # add an unexpected file there or prevent the same journal from being resumed.
    fd, name = tempfile.mkstemp(prefix=".chipload-workload-", dir=path.parent.parent)
    try:
        with os.fdopen(fd, "w") as output:
            output.write(value + "\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(name, path)
        archive.sync_directory(path.parent)
    finally:
        Path(name).unlink(missing_ok=True)


def ensure_mounts(api, profile):
    config = HttpAdapterConfig.model_validate(profile["adapter"]).secrets
    for collection, path, expected in (
        ("sys/mounts", config.kv_mount, {"type": "kv", "options": {"version": "2"}}),
        ("sys/auth", config.auth_mount, {"type": "approle"}),
    ):
        mounts = api.call("GET", collection)[1]["data"]
        existing = mounts.get(path + "/")
        if existing is None:
            api.call("POST", collection + "/" + path, expected)
        elif existing["type"] != expected["type"] or (
            "options" in expected and existing.get("options", {}).get("version") != "2"
        ):
            raise WorkloadError("existing mount differs from the workload contract")


def provision_resources(api, pending):
    profile = pending["profile"]
    ensure_mounts(api, profile)
    acl, role, path = addresses(profile)
    config = HttpAdapterConfig.model_validate(profile["adapter"]).secrets
    if api.call("GET", acl, statuses=(200, 404))[0] == 404:
        api.call("PUT", acl, {"policy": policy(profile)})
    if api.call("GET", role, statuses=(200, 404))[0] == 404:
        api.call("POST", role, role_config(profile))
    assert_config(api, profile)
    status, result = api.call("GET", path, statuses=(200, 404))
    if status == 404:
        api.call(
            "POST",
            path,
            {"options": {"cas": 0}, "data": {config.field: pending["receiver_secret"]}},
        )
    elif result["data"]["data"] != {config.field: pending["receiver_secret"]}:
        raise WorkloadError("initial receiver secret path already contains different data")


def complete(api, pending, receipt):
    directory = api.state / "workloads"
    directory.mkdir(mode=0o700, exist_ok=True)
    archive.private(directory, directory=True)
    archive.replace_json(directory / (receipt["name"] + ".json"), receipt)
    (api.state / PENDING).unlink()
    archive.sync_directory(api.state)
    return {
        "workload": receipt["name"],
        "status": receipt["status"],
        "generation": receipt["generation"],
        "expires_at": receipt.get("expires_at"),
    }


def advance(api, pending):
    profile = pending["profile"]
    if pending.get("owner") != stack.ownership_key(api.state, api.value):
        raise WorkloadError("workload journal belongs to another deployment")
    validate_profile(api, profile, check_credentials=pending["action"] != "revoke")
    acl, role, _ = addresses(profile)
    if pending["action"] == "revoke":
        # Revocation must still narrow access if an administrator broadened this
        # managed policy. Its reserved name is established by our durable intent.
        api.call("PUT", acl, {"policy": REVOKED_POLICY})
        if api.call("GET", acl)[1]["data"]["policy"] != REVOKED_POLICY:
            raise WorkloadError("workload policy revocation was not verified")
        api.call("DELETE", role)
        if api.call("GET", role, statuses=(200, 404))[0] != 404:
            raise WorkloadError("AppRole removal was not verified")
        if pending.get("role_id") or profile.get("role_id"):
            for secret in (pending.get("old_secret_id"), pending.get("next_secret_id")):
                if secret:
                    assert_denied_login(
                        api, profile, pending.get("role_id", profile.get("role_id")), secret
                    )
        return complete(
            api, pending, {**profile, "status": "revoked", "revoked_at": int(time.time())}
        )
    directory = credential_directory(api.state, profile)
    if pending["action"] == "provision":
        provision_resources(api, pending)
    role_id = assert_config(api, profile)
    if pending.get("role_id", role_id) != role_id:
        raise WorkloadError("AppRole identity changed during credential rotation")
    pending["role_id"] = role_id
    save_pending(api, pending)
    secret_id = pending["next_secret_id"]
    detail = lookup(api, profile, secret_id)
    if detail is None:
        if pending.get("issued"):
            raise WorkloadError(
                "pending credential expired or was removed; revoke this workload before reprovisioning"
            )
        if time.time() > pending["started_at"] + profile["secret_id_ttl"]:
            raise WorkloadError(
                "pending issuance exceeded its lifetime; revoke this workload before reprovisioning"
            )
        api.call(
            "POST",
            role + "/custom-secret-id",
            {
                "secret_id": secret_id,
                "ttl": profile["secret_id_ttl"],
                "metadata": json.dumps({"chipload_operation": pending["id"]}),
            },
        )
        detail = lookup(api, profile, secret_id)
    if detail is None or detail.get("metadata", {}).get("chipload_operation") != pending["id"]:
        raise WorkloadError("issued credential does not match the pending operation")
    pending["issued"] = True
    save_pending(api, pending)
    version = verify_login(api, profile, role_id, secret_id)
    install_file(directory / "role-id", role_id)
    old = pending.get("old_secret_id")
    install_file(directory / "secret-id", secret_id, digest_secret(old) if old else None)
    if old:
        api.call("POST", role + "/secret-id/destroy", {"secret_id": old})
        assert_denied_login(api, profile, role_id, old)
    # Record the server's expiry; a resumed issuance must not promise a fresh TTL.
    receipt = {
        **profile,
        "status": "active",
        "role_id": role_id,
        "secret_sha256": digest_secret(secret_id),
        "secret_accessor": detail["secret_id_accessor"],
        "expires_at": detail["expiration_time"],
        "verified_secret_version": version,
    }
    return complete(api, pending, receipt)


def operate(args):
    state = args.state.absolute()
    with stack.tls.operation_lock(state):
        api = API(state, args.operator_token.absolute())
        marker = state / PENDING
        if marker.exists() or marker.is_symlink():
            pending = stack.read_json(marker)
            if args.action == "revoke" and args.workload == pending["profile"]["name"]:
                pending["action"] = "revoke"
                save_pending(api, pending)
            elif args.action != "resume":
                raise WorkloadError("resume the pending workload operation before starting another")
            return advance(api, pending)
        if args.action == "resume":
            raise WorkloadError("there is no pending workload operation")
        if args.action == "provision":
            definition = HttpAdapterConfig.model_validate_json(
                private_bytes(args.adapter, 128 * 1024)
            )
            profile = {
                "version": 1,
                "name": definition.secrets.policy,
                "adapter": definition.model_dump(mode="json"),
                "credentials": str(args.credentials.absolute()),
                "cluster_id": api.cluster,
                "secret_id_ttl": args.secret_id_ttl,
                "generation": 1,
            }
            validate_profile(api, profile)
            credential_directory(state, profile, initial=True)
            receipt = state / "workloads" / (profile["name"] + ".json")
            if receipt.exists() or receipt.is_symlink():
                raise WorkloadError(
                    "workload name already has a managed receipt; use a new identity"
                )
            for path in addresses(profile):
                if api.call("GET", path, statuses=(200, 404))[0] != 404:
                    raise WorkloadError("workload policy, role or secret path already exists")
            if args.receiver_secret.resolve().is_relative_to(
                state
            ) or args.operator_token.resolve().is_relative_to(args.credentials.resolve()):
                raise WorkloadError(
                    "keep operator and receiver inputs outside service and workload state"
                )
            receiver_secret = read_secret(args.receiver_secret)
            old = None
        else:
            if not re.fullmatch(r"[a-z][a-z0-9-]{0,63}", args.workload):
                raise WorkloadError("invalid workload name")
            profile = stack.read_json(state / "workloads" / (args.workload + ".json"))
            if profile.get("name") != args.workload:
                raise WorkloadError("workload receipt belongs to another identity")
            validate_profile(api, profile, check_credentials=args.action != "revoke")
            if profile["status"] != "active":
                raise WorkloadError("workload is revoked; provision a new identity")
            directory = Path(profile["credentials"])
            old = None if args.action == "revoke" else read_secret(directory / "secret-id")
            if args.action != "revoke" and (
                digest_secret(old) != profile["secret_sha256"]
                or read_secret(directory / "role-id") != profile["role_id"]
            ):
                raise WorkloadError(
                    "workload files disagree with the managed receipt; reconcile external recovery state"
                )
            if args.action == "verify":
                role_id = assert_config(api, profile)
                if role_id != profile["role_id"]:
                    raise WorkloadError("managed AppRole identity changed")
                version = verify_login(api, profile, role_id, old)
                return {
                    "workload": profile["name"],
                    "verified": True,
                    "secret_version": version,
                    "expires_at": profile["expires_at"],
                }
            receiver_secret = None
            profile = {**profile, "generation": profile["generation"] + 1}
        pending = {
            "version": 1,
            "owner": stack.ownership_key(state, api.value),
            "id": secrets.token_hex(16),
            "action": args.action,
            "started_at": int(time.time()),
            "profile": profile,
            "next_secret_id": secrets.token_urlsafe(32),
            "old_secret_id": old,
            "receiver_secret": receiver_secret,
        }
        save_pending(api, pending)
        return advance(api, pending)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--state", type=Path, default=ROOT / ".local/secrets")
    parser.add_argument("--operator-token", type=Path, required=True)
    actions = parser.add_subparsers(dest="action", required=True)
    provision = actions.add_parser("provision")
    provision.add_argument("--adapter", type=Path, required=True)
    provision.add_argument("--credentials", type=Path, required=True)
    provision.add_argument("--receiver-secret", type=Path, required=True)
    provision.add_argument("--secret-id-ttl", type=int, default=86400)
    for name in ("rotate", "verify", "revoke"):
        actions.add_parser(name).add_argument("--workload", required=True)
    actions.add_parser("resume")
    args = parser.parse_args()
    if os.getuid() == 0:
        parser.error("run as the non-root deployment owner")
    try:
        result = operate(args)
    except WorkloadError as error:
        parser.exit(1, f"secrets-workload: {error}\n")
    except Exception:
        parser.exit(
            1,
            "secrets-workload: request failed; preserve the journal and retry with resume after checking service health, private files and operator permissions.\n",
        )
    print(json.dumps(result))


if __name__ == "__main__":
    main()
