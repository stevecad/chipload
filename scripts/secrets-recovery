#!/usr/bin/env python3
"""Encrypted offline recovery of the single-node TLS OpenBao deployment."""

import argparse
import importlib.machinery
import importlib.util
import io
import json
import os
import re
import shutil
import stat
import subprocess
import tarfile
import tempfile
import time
import uuid
from pathlib import Path

import recovery_archive as archive

from chipload.project import unique_json

ROOT = Path(__file__).resolve().parents[1]
loader = importlib.machinery.SourceFileLoader(
    "recovery_secrets_stack", str(ROOT / "scripts/secrets-stack")
)
stack = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(stack)

MARKER = stack.BACKUP_PENDING
FORMAT = "chipload-openbao-offline-v1"
MAX_ENTRIES = 10000
MAX_MANIFEST = 4 * 1024**2
FIXED = {
    "deployment.json",
    "server.hcl",
    "initialized.json",
    "bootstrap.json",
    "certificates/server.crt",
    "certificates/server.key",
    "certificates/ca.pem",
}
DIRECTORIES = {"certificates", "data", "audit", "data/raft", "data/raft/snapshots"}
REQUIRED = FIXED | DIRECTORIES | {"data/raft/raft.db", "data/vault.db"}


def contract():
    return {"image": stack.IMAGE, "compose": archive.digest(ROOT / "deploy/secrets/compose.yaml")}


def allowed(name):
    parts = name.split("/")
    return (
        len(name) <= 512
        and len(parts) <= 16
        and all(part not in {"", ".", ".."} for part in parts)
        and "\\" not in name
        and (
            name in FIXED | DIRECTORIES | {"recovery.json", "workloads"}
            or parts[0] in {"data", "audit"}
            or re.fullmatch(r"workloads/[a-z][a-z0-9-]{0,63}\.json", name) is not None
        )
    )


def validate_state(state, *, source=None):
    value = stack.configuration(stack.read_json(state / "deployment.json"))
    stack.check_storage(state)
    stack.check_tls(state)
    if (state / "server.hcl").read_text() != stack.server_config(value):
        raise ValueError("secrets configuration differs from the recovery contract")
    record = stack.read_json(state / "initialized.json")
    if (
        record.get("version") != 1
        or record.get("owner") != stack.ownership_key(source or state, value)
        or not isinstance(record.get("cluster_id"), str)
        or not record["cluster_id"]
    ):
        raise ValueError("recovery requires a completed initialization and pinned cluster identity")
    bootstrap = stack.read_json(state / "bootstrap.json")
    if (
        bootstrap.get("version") != 1
        or bootstrap.get("threshold") != value["threshold"]
        or bootstrap.get("fingerprints") != value["fingerprints"]
        or bootstrap.get("root_fingerprint") != value["root_fingerprint"]
    ):
        raise ValueError("bootstrap custody differs from the deployment")
    return value, record


def storage_users(state, *, except_id=None):
    """Include stopped containers: their restart could invalidate an offline copy."""
    listing = ["docker", "ps", "-aq", "--no-trunc"]
    identifiers = subprocess.check_output(listing, text=True, timeout=15).split()
    for identifier in identifiers:
        try:
            container = json.loads(
                subprocess.check_output(
                    ["docker", "inspect", identifier], text=True, stderr=subprocess.PIPE, timeout=15
                )
            )[0]
        except subprocess.CalledProcessError:
            # Other projects may remove their containers while we enumerate. A
            # failed inspection alone is not evidence of removal: recheck Docker.
            if identifier in subprocess.check_output(listing, text=True, timeout=15).split():
                raise
            continue
        if container["Id"] == except_id:
            continue
        for mount in container["Mounts"]:
            if mount["Type"] == "bind":
                source = Path(mount["Source"]).resolve()
                if source.is_relative_to(state) or state.is_relative_to(source):
                    raise ValueError(
                        "another container mounts secrets state; stop and remove it first"
                    )


def owned_mounts(state, container):
    if container is None:
        return
    expected = {
        "/etc/openbao/server.hcl": (str(state / "server.hcl"), False),
        "/tls": (str(state / "certificates"), False),
        "/bao/data": (str(state / "data"), True),
        "/bao/audit": (str(state / "audit"), True),
    }
    actual = {
        m["Destination"]: (m["Source"], m["RW"]) for m in container["Mounts"] if m["Type"] == "bind"
    }
    if actual != expected or any(m["Type"] == "volume" for m in container["Mounts"]):
        raise ValueError("container storage differs from the secrets deployment")


def pack(state, target, intent):
    entries = {}
    total = 0

    def visit(directory):
        nonlocal total
        for path in sorted(directory.iterdir()):
            name = path.relative_to(state).as_posix()
            if name in {".operation.lock", MARKER}:
                continue
            info = path.lstat()
            if not allowed(name) or not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode)):
                raise ValueError("recovery state contains unexpected paths, links or special files")
            is_directory = stat.S_ISDIR(info.st_mode)
            archive.private(path, directory=is_directory)
            if not is_directory and info.st_nlink != 1:
                raise ValueError("recovery state contains hard links")
            entries[name] = {"directory": is_directory, "size": 0 if is_directory else info.st_size}
            if not is_directory:
                entries[name]["sha256"] = archive.digest(path)
                total += info.st_size
            if len(entries) > MAX_ENTRIES or total > archive.MAX_BYTES:
                raise ValueError("recovery storage exceeds its entry or byte limit")
            if is_directory:
                visit(path)

    visit(state)
    if not REQUIRED <= entries.keys():
        raise ValueError("recovery state is incomplete")
    manifest = {
        "format": FORMAT,
        "contract": contract(),
        "intent": intent,
        "created_at": int(time.time()),
        "source": str(state),
        "entries": entries,
    }
    payload = json.dumps(manifest, sort_keys=True).encode()
    if len(payload) > MAX_MANIFEST:
        raise ValueError("recovery manifest exceeds its limit")
    archive.write(target, b"")
    with tarfile.open(target, "w", format=tarfile.USTAR_FORMAT) as output:
        header = tarfile.TarInfo("manifest.json")
        header.size, header.mode = len(payload), 0o600
        output.addfile(header, io.BytesIO(payload))
        for name, entry in entries.items():
            header = tarfile.TarInfo(name)
            header.mode = 0o700 if entry["directory"] else 0o600
            header.type = tarfile.DIRTYPE if entry["directory"] else tarfile.REGTYPE
            header.size = entry["size"]
            if entry["directory"]:
                output.addfile(header)
            else:
                with (state / name).open("rb") as source:
                    output.addfile(header, source)
    return manifest


def check_tar_headers(source):
    """Reject extended/sparse headers before tarfile can interpret or allocate them."""
    size = source.stat().st_size
    if size > archive.MAX_BYTES:
        raise ValueError("recovery archive exceeds its byte limit")
    with source.open("rb") as incoming:
        for _ in range(MAX_ENTRIES + 2):
            block = incoming.read(512)
            if block == bytes(512):
                padding = incoming.read(10241)
                if len(padding) > 10240 or any(padding):
                    raise ValueError("unexpected data after the recovery archive")
                return
            header = tarfile.TarInfo.frombuf(block, "utf-8", "strict")
            if (
                header.type not in {tarfile.REGTYPE, tarfile.DIRTYPE}
                or not 0 <= header.size <= size
            ):
                raise ValueError("recovery archive requires plain regular files and directories")
            end = incoming.tell() + ((header.size + 511) // 512) * 512
            if end > size:
                raise ValueError("truncated recovery archive")
            incoming.seek(end)
    raise ValueError("recovery archive exceeds its entry limit")


def unpack(source, destination):
    """Apply no archived ownership, permissions, links or extraction paths."""
    check_tar_headers(source)
    destination.mkdir(mode=0o700)
    with tarfile.open(source, "r:") as incoming:
        first = incoming.next()
        if (
            first is None
            or first.name != "manifest.json"
            or not first.isfile()
            or not 0 <= first.size <= MAX_MANIFEST
        ):
            raise ValueError("invalid secrets recovery manifest")
        manifest = unique_json(incoming.extractfile(first).read())
        if (
            not isinstance(manifest, dict)
            or manifest.get("format") != FORMAT
            or manifest.get("contract") != contract()
        ):
            raise ValueError("recovery requires the backed-up OpenBao image and deployment version")
        entries = manifest.get("entries")
        if (
            not isinstance(entries, dict)
            or not REQUIRED <= entries.keys()
            or len(entries) > MAX_ENTRIES
        ):
            raise ValueError("invalid secrets recovery entries")
        for name, entry in entries.items():
            if (
                not allowed(name)
                or not isinstance(entry, dict)
                or type(entry.get("directory")) is not bool
                or type(entry.get("size")) is not int
                or entry["size"] < 0
                or (entry["directory"] and entry["size"] != 0)
                or (
                    not entry["directory"]
                    and not re.fullmatch(r"[0-9a-f]{64}", str(entry.get("sha256")))
                )
                or (name in DIRECTORIES and not entry["directory"])
                or (name in FIXED and entry["directory"])
            ):
                raise ValueError("invalid secrets recovery path or metadata")
        if sum(entry["size"] for entry in entries.values()) > archive.MAX_BYTES:
            raise ValueError("recovery storage exceeds its byte limit")
        members, seen = iter(incoming), set()
        next(members)
        for member in members:
            entry = entries.get(member.name)
            if (
                entry is None
                or member.name in seen
                or member.size != entry["size"]
                or (entry["directory"] and not member.isdir())
                or (not entry["directory"] and not member.isfile())
            ):
                raise ValueError("invalid, linked or repeated secrets recovery member")
            path = destination / member.name
            if entry["directory"]:
                path.mkdir(mode=0o700)
            else:
                # Parents must already be declared directories, not implicit archive paths.
                archive.private(path.parent, directory=True)
                archive.write(path, b"")
                with incoming.extractfile(member) as source_file, path.open("wb") as output:
                    shutil.copyfileobj(source_file, output, length=1024**2)
                    output.flush()
                    os.fsync(output.fileno())
                if archive.digest(path) != entry["sha256"]:
                    raise ValueError("secrets recovery file digest mismatch")
            seen.add(member.name)
        if seen != entries.keys():
            raise ValueError("secrets recovery archive is incomplete")
    value, record = validate_state(destination, source=Path(manifest["source"]))
    if manifest["intent"]["owner"] != record["owner"]:
        raise ValueError("secrets recovery intent does not match its deployment")
    return manifest, value, record


def paths(args):
    state, key, target = args.state.absolute(), args.key.absolute(), args.archive.absolute()
    if state != state.resolve():
        raise ValueError("use a canonical secrets state path without symlinks")
    archive.private(state.parent, directory=True)
    archive.private(target.parent, directory=True)
    archive.check_key(key)
    if (
        key.resolve().is_relative_to(state)
        or target.resolve().is_relative_to(state)
        or key.resolve() == target.resolve()
    ):
        raise ValueError("keep archives and their encryption key separate from secrets state")
    return state, key, target


def finish_backup(state):
    (state / MARKER).unlink()
    archive.sync_directory(state)


def backup(args):
    state, key, target = paths(args)
    with stack.tls.operation_lock(state):
        value, command, environment, container = stack.deployment(state)
        if (state / stack.WORKLOAD_PENDING).exists() or (
            state / stack.WORKLOAD_PENDING
        ).is_symlink():
            raise ValueError("finish the pending workload change before backup")
        if (state / stack.PENDING).exists() or (state / stack.PENDING).is_symlink():
            raise ValueError("finish initialization before backup")
        validate_state(state)
        owned_mounts(state, container)
        storage_users(state, except_id=container["Id"] if container else None)
        marker = state / MARKER
        expected = {
            "version": 1,
            "owner": stack.ownership_key(state, value),
            "archive": str(target),
            "key_sha256": archive.digest(key),
        }
        if marker.exists() or marker.is_symlink():
            intent = stack.read_json(marker)
            if {k: intent.get(k) for k in expected} != expected:
                raise ValueError("resume backup with the original archive path and encryption key")
        else:
            if target.exists() or target.is_symlink():
                raise ValueError("backup output already exists")
            intent = {**expected, "id": uuid.uuid4().hex}
            archive.replace_json(marker, intent)
        # Removal disables automatic restarts while reading storage and on interruption.
        stack.compose(command, environment, "down")
        storage_users(state)
        with tempfile.TemporaryDirectory(prefix=".secrets-backup-", dir=target.parent) as temporary:
            working = Path(temporary)
            plain, encrypted = working / "state.tar", working / "state.gpg"
            if target.exists() or target.is_symlink():
                archive.crypt(target, plain, key, decrypt=True)
                manifest, _, _ = unpack(plain, working / "checked")
                if manifest["intent"] != intent:
                    raise ValueError("existing archive does not match the pending backup")
            else:
                pack(state, plain, intent)
                # Verify the produced archive before publishing it; catch changed source bytes.
                unpack(plain, working / "checked")
                archive.crypt(plain, encrypted, key)
                os.link(encrypted, target)  # Atomic publication without replacing an existing file.
                archive.sync_directory(target.parent)
            finish_backup(state)
        return {"backup": str(target), "stopped": True}


def restore(args):
    state, key, source = paths(args)
    # Serialize fresh installs without creating a startup-visible partial destination.
    with stack.tls.operation_lock(state.parent):
        if state.exists() or state.is_symlink():
            raise ValueError("restore requires a fresh state directory")
        stack.executor.runtime.docker_socket()
        storage_users(state)
        with tempfile.TemporaryDirectory(prefix=".secrets-restore-", dir=state.parent) as temporary:
            working = Path(temporary)
            plain, prepared = working / "state.tar", working / "state"
            archive.crypt(source, plain, key, decrypt=True)
            manifest, value, record = unpack(plain, prepared)
            # Preserve project/node ID, host and network. A restored clone must not coexist.
            if stack.ownership(value, stack.ownership_key(state, value)) is not None:
                raise ValueError("remove the existing secrets project before restoring")
            stack.executor.private_network(value["network"])
            old_state = Path(manifest["source"])
            storage_users(old_state)
            archive.replace_json(
                prepared / "initialized.json",
                {**record, "owner": stack.ownership_key(state, value)},
            )
            archive.replace_json(
                prepared / "recovery.json",
                {
                    "version": 1,
                    "backup_id": manifest["intent"]["id"],
                    "archive_sha256": archive.digest(source),
                    "restored_at": int(time.time()),
                    "cluster_id": record["cluster_id"],
                },
            )
            validate_state(prepared, source=state)
            archive.sync_tree(prepared)
            os.rename(prepared, state)
            archive.sync_directory(state.parent)
        return {"restored": str(state), "cluster_id": record["cluster_id"], "unseal_required": True}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--state", type=Path, default=ROOT / ".local/secrets")
    actions = parser.add_subparsers(dest="action", required=True)
    actions.add_parser("keygen").add_argument("--key", type=Path, required=True)
    for name in ("backup", "restore"):
        action = actions.add_parser(name)
        action.add_argument("--key", type=Path, required=True)
        action.add_argument("--archive", type=Path, required=True)
    args = parser.parse_args()
    if os.getuid() == 0:
        parser.error("run as the non-root deployment owner")
    try:
        if args.action == "keygen":
            archive.generate_key(args.key)
            result = {"key_file": str(args.key.absolute())}
        else:
            result = backup(args) if args.action == "backup" else restore(args)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError, tarfile.TarError):
        parser.exit(
            1,
            "secrets-recovery: operation failed; preserve state, archive and key. Check private paths, matching deployment, initialization and the original backup arguments. No secret data is printed.\n",
        )
    print(json.dumps(result))


if __name__ == "__main__":
    main()
