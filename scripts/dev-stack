#!/usr/bin/env python3
"""Manage the local Keycloak/PostgreSQL/OpenBao development stack."""

import argparse
import json
import os
from pathlib import Path
import secrets
import subprocess
import sys
import tempfile
from urllib.error import HTTPError, URLError
from urllib.request import ProxyHandler, Request, build_opener


ROOT = Path(__file__).resolve().parents[1]
STATE = ROOT / ".local" / "dev-stack"


class StackError(Exception):
    pass


def private_write(path, value, *, replace=False):
    """Never expose a partially written secret or rely on the caller's umask."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as stream:
            stream.write(value)
        if replace:
            os.replace(temporary, path)
        else:
            # A hard link publishes atomically and fails if the target exists.
            os.link(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def ensure_env():
    path = ROOT / ".env"
    if not path.exists():
        private_write(path, "\n".join([
            "# Local development only; generated by scripts/dev-stack.",
            "KEYCLOAK_PORT=8080", "OPENBAO_PORT=8200",
            "KEYCLOAK_ADMIN_USERNAME=admin",
            "KEYCLOAK_ADMIN_PASSWORD=" + secrets.token_urlsafe(32),
            "KEYCLOAK_DB_PASSWORD=" + secrets.token_urlsafe(32), "",
        ]))


def compose(*args, capture=False):
    result = subprocess.run(
        ["docker", "compose", "--project-directory", str(ROOT),
         "--file", str(ROOT / "compose.yaml"), *args],
        text=True, capture_output=capture,
    )
    if result.returncode:
        # config can include secrets: never echo captured output.
        raise StackError("Docker Compose failed. Check Docker, .env, ports, and container logs.")
    return result.stdout if capture else None


def bao_request(base, method, path, data=None, *, token=None):
    headers = {"Content-Type": "application/json"}
    if token:
        headers["X-Vault-Token"] = token
    request = Request(
        base + "/v1/" + path, method=method, headers=headers,
        data=json.dumps(data).encode() if data is not None else None,
    )
    # Loopback administrative traffic must not go through an HTTP proxy.
    try:
        with build_opener(ProxyHandler({})).open(request, timeout=15) as response:
            body = response.read()
            return json.loads(body) if body else None
    except HTTPError as error:
        raise StackError(f"OpenBao {method} {path} returned HTTP {error.code}.") from None
    except URLError:
        raise StackError("Cannot reach local OpenBao. Check Docker Compose status.") from None


def bootstrap(base):
    init_file = STATE / "openbao-init.json"
    initialized = bao_request(base, "GET", "sys/init")["initialized"]
    if not initialized:
        if init_file.exists():
            raise StackError("OpenBao storage is empty but old bootstrap keys exist. Preserve them and move the old .local/dev-stack directory before initializing new storage.")
        # One share is intentionally a local-development convenience.
        initial = bao_request(base, "PUT", "sys/init", {"secret_shares": 1, "secret_threshold": 1})
        private_write(init_file, json.dumps(initial, indent=2) + "\n")
    elif not init_file.exists():
        raise StackError("OpenBao is already initialized but .local/dev-stack/openbao-init.json is missing. Restore its bootstrap material; refusing to replace existing storage.")
    initial = json.loads(init_file.read_text())
    if bao_request(base, "GET", "sys/seal-status")["sealed"]:
        bao_request(base, "PUT", "sys/unseal", {"key": initial["keys_base64"][0]})
    if bao_request(base, "GET", "sys/seal-status")["sealed"]:
        raise StackError("OpenBao is still sealed after bootstrap.")
    token = initial["root_token"]

    def api(method, path, data=None):
        return bao_request(base, method, path, data, token=token)

    mounts = api("GET", "sys/mounts")["data"]
    if "chipload/" not in mounts:
        api("POST", "sys/mounts/chipload", {"type": "kv", "options": {"version": "2"}})
    elif mounts["chipload/"]["type"] != "kv" or mounts["chipload/"].get("options", {}).get("version") != "2":
        raise StackError("Existing chipload/ mount is not KV v2; refusing to replace it.")
    auth = api("GET", "sys/auth")["data"]
    if "approle/" not in auth:
        api("POST", "sys/auth/approle", {"type": "approle"})
    elif auth["approle/"]["type"] != "approle":
        raise StackError("Existing approle/ mount uses another auth type.")
    audit = api("GET", "sys/audit")["data"]
    if audit.get("file/", {}).get("type") != "file":
        raise StackError("The configured OpenBao audit device is missing. Check config.hcl and restart OpenBao before bootstrapping.")
    policy = (ROOT / "deploy/openbao/chipload-example.hcl").read_text()
    api("PUT", "sys/policies/acl/chipload-example", {"policy": policy})
    role = "auth/approle/role/chipload-example"
    api("POST", role, {
        "token_policies": ["chipload-example"], "token_no_default_policy": True,
        "token_ttl": "15m", "token_max_ttl": "1h", "secret_id_ttl": "24h",
    })
    role_id = api("GET", role + "/role-id")["data"]["role_id"]
    credential_file = STATE / "runtime-approle.json"
    old = json.loads(credential_file.read_text()) if credential_file.exists() else None
    secret = api("POST", role + "/secret-id", {})["data"]
    private_write(credential_file, json.dumps({
        "role_id": role_id, "secret_id": secret["secret_id"],
        "secret_id_accessor": secret["secret_id_accessor"],
    }, indent=2) + "\n", replace=True)
    if old:
        api("POST", role + "/secret-id-accessor/destroy", {"secret_id_accessor": old["secret_id_accessor"]})


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("up", "down", "status"))
    args = parser.parse_args()
    if args.command == "up":
        ensure_env()
        config = json.loads(compose("config", "--format", "json", capture=True))
        compose("up", "--detach", "--wait", "--wait-timeout", "180")
        bao_port = config["services"]["openbao"]["ports"][0]["published"]
        keycloak_port = config["services"]["keycloak"]["ports"][0]["published"]
        bootstrap(f"http://127.0.0.1:{bao_port}")
        print(f"Keycloak: http://localhost:{keycloak_port} (realm: chipload)")
        print(f"OpenBao:  http://localhost:{bao_port} (initialized and unsealed)")
        print("Admin login is in .env; local recovery keys and restricted workload credentials are in .local/dev-stack/.")
        print("Development infrastructure is ready. See docs/API.md for the host runtime and docs/RUNTIME.md for application containers.")
    elif args.command == "down":
        compose("down")  # Preserve volumes and bootstrap material.
    else:
        compose("ps")


if __name__ == "__main__":
    try:
        main()
    except (StackError, OSError, ValueError, KeyError) as error:
        print(f"dev-stack: {error}", file=sys.stderr)
        sys.exit(1)
