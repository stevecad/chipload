#!/usr/bin/env python3
"""Build the locked OpenBao service without deployment credentials."""

import argparse
import re
import subprocess
import tempfile
from pathlib import Path

from secrets_environment import INPUTS, build_specification, resolve_image, snapshot


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--rebuild", action="store_true", help="rebuild an existing image reference")
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    contents = snapshot(root)
    reference, fingerprint = build_specification(contents)
    if not args.rebuild:
        available = subprocess.check_output(
            ["docker", "image", "ls", "--quiet", reference], timeout=15
        ).strip()
        if available:
            image = resolve_image(reference, fingerprint)
            print("OpenBao image:", image)
            print("Build reference:", reference)
            return
    with tempfile.TemporaryDirectory(prefix="chipload-secrets-image-") as directory:
        context = Path(directory)
        for source, target in zip(
            INPUTS, ("Dockerfile", "openbao.go.mod", "openbao.go.sum", "LICENSE"), strict=True
        ):
            (context / target).write_bytes(contents[source])
        subprocess.run(
            [
                "docker",
                "build",
                "--build-arg",
                "SECRETS_SHA256=" + fingerprint,
                "--tag",
                reference,
                "--iidfile",
                str(context / "image-id"),
                str(context),
            ],
            check=True,
        )
        image = (context / "image-id").read_text().strip()
        if re.fullmatch(r"sha256:[a-f0-9]{64}", image) is None:
            raise ValueError("Docker did not return an immutable OpenBao image ID")
        print("OpenBao image:", image)
        print("Build reference:", reference)


if __name__ == "__main__":
    main()
