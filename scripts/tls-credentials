#!/usr/bin/env python3
"""Rotate TLS deployment credentials and Keycloak signing keys."""

import argparse
import hashlib
import http.client
import importlib.machinery
import importlib.util
import json
import os
import re
import secrets
import socket
import ssl
import subprocess
import tempfile
import uuid
from datetime import datetime, timezone
from pathlib import Path
from types import SimpleNamespace
from urllib.parse import quote, urlencode

import recovery_archive as archive

ROOT = Path(__file__).resolve().parents[1]
loader = importlib.machinery.SourceFileLoader(
    "credential_recovery_helpers", str(ROOT / "scripts/tls-recovery")
)
recovery = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(recovery)
spec = importlib.util.spec_from_file_location("tls_signing", ROOT / "scripts/tls_signing.py")
signing = importlib.util.module_from_spec(spec)
spec.loader.exec_module(signing)
stack = recovery.stack
MARKER = ".credentials-incomplete.json"
STABLE_FILES = ("deployment.json", "runtime.json", "client.json", "identity-ca.pem")
SECRET_FILES = {"agent": "agent-secret", "database": "db-password"}


class CredentialError(ValueError):
    """An operator-safe diagnostic which contains no returned credential data."""


def request(state, values, path, *, method="GET", data=None, token=None, admin=False, api=False):
    """Local connection with verified configured SNI/Host; no proxy or redirects."""
    host = values["api_host" if api else "identity_host"]
    port = values["admin_port" if admin else "port"]
    context = ssl.create_default_context(cafile=state / "identity-ca.pem")
    body, headers = None, {}
    if data is not None:
        form = path.endswith("/protocol/openid-connect/token")
        body = (urlencode(data) if form else json.dumps(data)).encode()
        headers["Content-Type"] = (
            "application/x-www-form-urlencoded" if form else "application/json"
        )
    if token:
        headers["Authorization"] = "Bearer " + token
    connection = http.client.HTTPSConnection(host, port, timeout=15, context=context)
    raw = socket.create_connection((stack.connect_address(values, admin=admin), port), timeout=15)
    try:
        connection.sock = context.wrap_socket(raw, server_hostname=host)
        connection.request(method, path, body=body, headers=headers)
        response = connection.getresponse()
        result = response.read(1024 * 1024 + 1)
        if len(result) > 1024 * 1024:
            raise CredentialError("credential verification response exceeded its limit")
        # Never include response bodies in errors: they can contain secrets or tokens.
        return response.status, json.loads(result) if result else None
    finally:
        connection.close()
        raw.close()


def expect(status, result, expected):
    if status != expected:
        raise CredentialError(f"credential operation returned HTTP {status}; expected {expected}")
    return result


def secret(value):
    if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9_-]{32,256}", value):
        raise CredentialError(
            "deployment credential is not in the supported generated-secret format"
        )
    return value


def replace_secret(path, value, *, mode):
    # Atomic replacement needs container recreation for individual-file bind mounts.
    fd, temporary = tempfile.mkstemp(prefix=".credential-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as output:
            output.write(secret(value))
            os.fchmod(output.fileno(), mode)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        archive.sync_directory(path.parent)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def realm_record(state):
    realm = json.loads((state / "realm.json").read_bytes())
    clients = [c for c in realm["clients"] if c["clientId"] == "chipload-agent"]
    if len(clients) != 1:
        raise CredentialError("expected exactly one shop-agent client in the realm import")
    return realm, clients[0]


def stable_state(state):
    realm, client = realm_record(state)
    client.pop("secret", None)
    return {
        **{name: archive.digest(state / name) for name in STABLE_FILES},
        "realm": hashlib.sha256(json.dumps(realm, sort_keys=True).encode()).hexdigest(),
    }


def operator_token(state, values, username, password_file, token_file=None):
    if token_file is not None:
        archive.private(token_file.parent, directory=True)
        archive.private(token_file)
        if token_file.stat().st_size > 64 * 1024:
            raise CredentialError("operator token file exceeds its size limit")
        value = token_file.read_text().strip()
        if not value or any(character.isspace() for character in value):
            raise CredentialError("operator token file must contain one access token")
        return value
    archive.private(password_file.parent, directory=True)
    archive.private(password_file)
    if password_file.stat().st_size > 4096:
        raise CredentialError("operator password file exceeds its size limit")
    password = password_file.read_text().rstrip("\r\n")
    status, result = request(
        state,
        values,
        "/realms/master/protocol/openid-connect/token",
        method="POST",
        admin=True,
        data={
            "grant_type": "password",
            "client_id": "admin-cli",
            "username": username,
            "password": password,
        },
    )
    return expect(status, result, 200)["access_token"]


def agent_token(state, values, password):
    return request(
        state,
        values,
        "/realms/chipload/protocol/openid-connect/token",
        method="POST",
        data={
            "grant_type": "client_credentials",
            "client_id": "chipload-agent",
            "client_secret": password,
        },
    )


def rejected(status, result):
    if (
        status != 401
        or not isinstance(result, dict)
        or result.get("error") not in {"invalid_client", "unauthorized_client"}
    ):
        raise CredentialError("the previous agent secret was not rejected by client authentication")


def agent_identity(state, values, password):
    token = expect(*agent_token(state, values, password), 200)["access_token"]
    return expect(*request(state, values, "/v1/identity", token=token, api=True), 200)


def client_path(state, values, token):
    clients = expect(
        *request(
            state,
            values,
            "/admin/realms/chipload/clients?clientId=chipload-agent&max=2",
            token=token,
            admin=True,
        ),
        200,
    )
    if len(clients) != 1 or clients[0]["clientId"] != "chipload-agent":
        raise CredentialError("expected exactly one existing shop-agent client in Keycloak")
    return "/admin/realms/chipload/clients/" + quote(clients[0]["id"], safe="")


def current_agent(state, values, token, path):
    return expect(
        *request(
            state,
            values,
            path + "/client-secret",
            token=token,
            admin=True,
        ),
        200,
    )["value"]


def verify_subject(state, values, token, path, subject):
    identity = expect(
        *request(
            state,
            values,
            path + "/service-account-user",
            token=token,
            admin=True,
        ),
        200,
    )
    if identity["id"] != subject:
        raise CredentialError(
            "Keycloak's service identity differs from the configured shop subject"
        )


def psql(command, environment, arguments, password):
    # Passwords travel only on stdin to psql prompts, never in argv or Docker env.
    result = subprocess.run(
        [
            *command,
            "exec",
            "-T",
            "keycloak-db",
            "psql",
            "--no-psqlrc",
            "--username=keycloak",
            "--dbname=keycloak",
            "--set=ON_ERROR_STOP=on",
            *arguments,
        ],
        env=environment,
        input=password.encode(),
        capture_output=True,
        timeout=30,
    )
    return result


def database_accepts(command, environment, password):
    # The service DNS name selects the private TCP address, not the trust-authenticated
    # local Unix socket or loopback interface used for operator maintenance.
    result = psql(
        command,
        environment,
        [
            "--host=keycloak-db",
            "--password",
            "--no-align",
            "--tuples-only",
            "--command=SELECT current_user",
        ],
        secret(password) + "\n",
    )
    if result.returncode == 0 and result.stdout.strip() == b"keycloak":
        return True
    if result.returncode == 2 and b"password authentication failed" in result.stderr:
        return False
    raise CredentialError(
        "database credential verification failed for a reason other than authentication"
    )


def set_database_password(command, environment, password):
    # psql encrypts the password before issuing ALTER ROLE, keeping plaintext out
    # of PostgreSQL statement logs. The owned container's local socket is trusted.
    result = psql(
        command,
        environment,
        [
            "--no-password",
            "--command=SET password_encryption = 'scram-sha-256'",
            "--command=\\password keycloak",
        ],
        (secret(password) + "\n") * 2,
    )
    if result.returncode:
        raise CredentialError("database password change failed; resume the pending rotation")


def rotate_agent(state, values, journal, token):
    path = client_path(state, values, token)
    if path != journal["client_path"]:
        raise CredentialError("the shop-agent client was replaced during rotation")
    verify_subject(state, values, token, path, journal["subject"])
    current = current_agent(state, values, token, path)
    if current not in {journal["old"], journal["new"]}:
        raise CredentialError("the agent secret changed outside this rotation")
    if current != journal["new"]:
        # Keycloak's update endpoint also applies defaults for omitted settings.
        # Preserve the existing representation, including authorization services.
        client = expect(*request(state, values, path, token=token, admin=True), 200)
        client["secret"] = journal["new"]
        expect(
            *request(
                state,
                values,
                path,
                method="PUT",
                data=client,
                token=token,
                admin=True,
            ),
            204,
        )
    # Explicitly invalidate any retained previous secret; no overlap window.
    expect(
        *request(
            state, values, path + "/client-secret/rotated", method="DELETE", token=token, admin=True
        ),
        204,
    )
    if agent_identity(state, values, journal["new"]) != journal["identity"]:
        raise CredentialError("the agent's effective identity or grants changed during rotation")
    rejected(*agent_token(state, values, journal["old"]))
    replace_secret(state / "secrets/agent-secret", journal["new"], mode=0o600)
    realm, client = realm_record(state)
    client["secret"] = journal["new"]
    archive.replace_json(state / "realm.json", realm)


def rotate_database(state, values, journal, command, environment):
    recovery.compose(command, environment, "stop", "keycloak")
    recovery.compose(
        command, environment, "up", "--detach", "--wait", "--wait-timeout", "60", "keycloak-db"
    )
    if not database_accepts(command, environment, journal["new"]):
        if not database_accepts(command, environment, journal["old"]):
            raise CredentialError("the database password changed outside this rotation")
        set_database_password(command, environment, journal["new"])
    if not database_accepts(command, environment, journal["new"]):
        raise CredentialError("the new database password was not accepted")
    if database_accepts(command, environment, journal["old"]):
        raise CredentialError("the previous database password was not rejected")
    replace_secret(state / "secrets/db-password", journal["new"], mode=0o444)
    recovery.compose(
        command,
        environment,
        "up",
        "--detach",
        "--force-recreate",
        "--wait",
        "--wait-timeout",
        "180",
        "keycloak-db",
        "keycloak",
    )
    # Verify a fresh identity token through the actual API after reconnection.
    if (
        agent_identity(state, values, (state / "secrets/agent-secret").read_text())
        != journal["identity"]
    ):
        raise CredentialError(
            "the agent's effective identity or grants changed during database rotation"
        )


def rotate(
    state,
    kind,
    *,
    resume=False,
    username="admin",
    password_file=None,
    token_file=None,
    retain_days=60,
):
    state = state.absolute()
    with stack.operation_lock(state):
        identity_marker = state / ".secrets-identity-incomplete.json"
        if identity_marker.exists() or identity_marker.is_symlink():
            raise CredentialError(
                "finish the pending secrets identity change before credential rotation"
            )
        marker = state / MARKER
        if resume:
            archive.private(marker)
            if marker.stat().st_size > 64 * 1024:
                raise CredentialError("rotation journal exceeds its size limit")
            journal = json.loads(marker.read_bytes())
            if journal.get("version") != 1 or journal.get("state") != str(state):
                raise CredentialError(
                    "rotation journal belongs to a different state directory or version"
                )
            kind = journal["kind"]
            if kind not in SECRET_FILES.keys() | signing.KINDS:
                raise CredentialError("invalid rotation journal")
            if kind in SECRET_FILES:
                if journal["old"] == journal["new"]:
                    raise CredentialError("invalid rotation journal")
                secret(journal["old"])
                secret(journal["new"])
            for other in (recovery.BACKUP_MARKER, recovery.RESTORE_MARKER):
                if (state / other).exists():
                    raise CredentialError("finish deployment recovery before credential rotation")
        else:
            stack.require_ready(state)
        command, environment, values = stack.deployment(state, check=True)
        running, _ = recovery.check_containers(
            state,
            values,
            environment,
            command,
            allow_partial=resume,
        )
        if not resume and not running:
            raise CredentialError(
                "start the complete healthy deployment before rotating credentials"
            )
        volume = recovery.records("volume", values["name"])[0]
        volume_identity = {key: volume[key] for key in ("Name", "CreatedAt", "Driver", "Labels")}
        password_file = password_file or state / "secrets/admin-password"
        token = (
            operator_token(state, values, username, password_file, token_file)
            if kind == "agent" or kind in signing.KINDS
            else None
        )
        signing_rotation = signing.Rotation(SimpleNamespace(**globals()), state, values, token)
        if resume:
            if journal["stable"] != stable_state(state) or journal["volume"] != volume_identity:
                raise CredentialError(
                    "deployment settings or identity storage changed during rotation"
                )
        else:
            identity = agent_identity(state, values, (state / "secrets/agent-secret").read_text())
            journal = {
                "version": 1,
                "state": str(state),
                "kind": kind,
                "rotation_id": uuid.uuid4().hex,
                "started_at": datetime.now(timezone.utc).isoformat(),
                "stable": stable_state(state),
                "volume": volume_identity,
                "identity": identity,
            }
            if kind in SECRET_FILES:
                old = secret((state / "secrets" / SECRET_FILES[kind]).read_text())
                journal.update(old=old, new=secrets.token_urlsafe(32))
            if kind == "agent":
                journal["subject"] = json.loads((state / "client.json").read_bytes())["subject"]
                journal["client_path"] = client_path(state, values, token)
                verify_subject(state, values, token, journal["client_path"], journal["subject"])
                if current_agent(state, values, token, journal["client_path"]) != old:
                    raise CredentialError(
                        "local agent secret differs from Keycloak; reconcile it first"
                    )
            elif kind == "database":
                if not database_accepts(command, environment, old):
                    raise CredentialError("local database password is not accepted")
                if database_accepts(command, environment, journal["new"]):
                    raise CredentialError(
                        "database accepted an unknown password; require TCP password authentication"
                    )
            else:
                journal.update(signing_rotation.prepare(kind, retain_days))
            archive.replace_json(marker, journal)
        if kind in SECRET_FILES and (state / "secrets" / SECRET_FILES[kind]).read_text() not in {
            journal["old"],
            journal["new"],
        }:
            raise CredentialError("the local credential changed outside this rotation")
        if kind == "agent":
            if realm_record(state)[1]["secret"] not in {journal["old"], journal["new"]}:
                raise CredentialError("the imported agent credential changed outside this rotation")
            rotate_agent(state, values, journal, token)
        elif kind == "database":
            rotate_database(state, values, journal, command, environment)
        elif kind == "signing":
            signing_rotation.rotate(journal)
        else:
            signing_rotation.retire(journal, command, environment)
        archive.replace_json(
            state / "credentials.json",
            {
                "version": 1,
                "rotation_id": journal["rotation_id"],
                "kind": kind,
                "started_at": journal["started_at"],
                "completed_at": datetime.now(timezone.utc).isoformat(),
                "operator_uid": os.getuid(),
            },
        )
        marker.unlink()
        archive.sync_directory(state)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--state", type=Path, default=ROOT / ".local/tls")
    parser.add_argument("--operator-user", default="admin")
    operator = parser.add_mutually_exclusive_group()
    operator.add_argument("--operator-password-file", type=Path)
    operator.add_argument("--operator-token-file", type=Path)
    parser.add_argument(
        "--retain-days",
        type=int,
        default=60,
        help="signing-key verification overlap, 1–365 days (default: 60)",
    )
    parser.add_argument(
        "action",
        choices=("rotate-agent", "rotate-database", "rotate-signing", "retire-signing", "resume"),
    )
    args = parser.parse_args()
    if os.getuid() == 0:
        parser.error("run as the non-root deployment owner")
    try:
        rotate(
            args.state,
            "signing-retire"
            if args.action == "retire-signing"
            else args.action.removeprefix("rotate-"),
            resume=args.action == "resume",
            username=args.operator_user,
            password_file=args.operator_password_file,
            token_file=args.operator_token_file,
            retain_days=args.retain_days,
        )
    except CredentialError as error:
        parser.exit(
            1,
            f"tls-credentials: {error}. Preserve pending state and use resume after correcting the cause.\n",
        )
    except (
        OSError,
        ValueError,
        KeyError,
        TypeError,
        subprocess.SubprocessError,
        http.client.HTTPException,
    ):
        # Exceptions from identity/parsing/subprocesses can contain response data.
        parser.exit(
            1,
            "tls-credentials: rotation failed. Preserve deployment state; if "
            ".credentials-incomplete.json exists, correct connectivity/settings and "
            "run resume. No secret values are printed.\n",
        )
    print("Credential operation verified. Deployment receipts record the completed change.")


if __name__ == "__main__":
    main()
