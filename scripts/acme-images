#!/usr/bin/env python3
"""Build the locked ACME issuer, optionally pulling the pinned local test CA."""

import argparse
import re
import subprocess
import tempfile
from pathlib import Path

from acme_environment import INPUTS, build_specification, snapshot


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tests", action="store_true")
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    pins, contents = snapshot(root)
    images, fingerprint = build_specification(pins, contents)
    with tempfile.TemporaryDirectory(prefix="chipload-issuer-image-") as directory:
        context = Path(directory)
        for source, target in zip(
            INPUTS, ("Dockerfile", "issuer.go.mod", "issuer.go.sum", "LICENSE"), strict=True
        ):
            (context / target).write_bytes(contents[source])
        subprocess.run(
            [
                "docker",
                "build",
                "--build-arg",
                "ISSUER_BASE=" + pins["issuer"],
                "--build-arg",
                "ACME_SHA256=" + fingerprint,
                "--tag",
                images["issuer"],
                "--iidfile",
                str(context / "image-id"),
                str(context),
            ],
            check=True,
        )
        image = (context / "image-id").read_text().strip()
        if re.fullmatch(r"sha256:[a-f0-9]{64}", image) is None:
            raise ValueError("Docker did not return an immutable issuer image ID")
        print("Issuer image:", image)
        print("Build reference:", images["issuer"])
    if args.tests:
        subprocess.run(["docker", "pull", images["test_ca"]], check=True)


if __name__ == "__main__":
    main()
