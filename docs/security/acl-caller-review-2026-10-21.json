    "code": "import hashlib\nimport importlib\nimport json\nimport os\nimport pathlib\nimport sys\n\nsymbols=(b'acl_get_file',b'acl_set_file',b'acl_extended_file',b'acl_delete_def_file',b'libacl.so.1')\nseen=set(); rows=[]; errors=[]; count=0\nroots=('/usr/bin','/usr/sbin','/usr/lib','/usr/local','/opt','/bin','/sbin','/lib')\nfor root in roots:\n    for parent,dirs,files in os.walk(root,onerror=lambda error: errors.append(str(error.filename))):\n        for name in files:\n            path=pathlib.Path(parent)/name\n            try:\n                path=path.resolve()\n                if path in seen or not path.is_file(): continue\n                seen.add(path)\n                with path.open('rb') as stream:\n                    if stream.read(4)!=b'\\x7fELF':continue\n                    stream.seek(0);data=stream.read()\n                count+=1\n                matches=[s.decode() for s in symbols if s+b'\\0' in data]\n                if matches:\n                    rows.append({'path':str(path),'sha256':hashlib.sha256(data).hexdigest(),'symbol_strings':matches})\n            except (PermissionError,FileNotFoundError):errors.append(str(path))\nimports=json.loads(sys.argv[1])\nfor name in imports: importlib.import_module(name)\nfrom chipload.artifact import sdk_fingerprint\nmaps=sorted({line.split()[-1] for line in pathlib.Path('/proc/self/maps').read_text().splitlines() if len(line.split())>=6 and line.split()[-1].startswith('/')})\nprint(json.dumps({'roots':roots,'elf_file_count':count,'unreadable_paths':errors,'candidates':rows,'trusted_imports':imports,'sdk_sha256':sdk_fingerprint(),'mapped_files_after_imports':maps}))\n",
